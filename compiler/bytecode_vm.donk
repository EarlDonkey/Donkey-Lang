fn run_bytecode(instructions) -> void {
    let stack = [];
    let env = {};
    let ip = 0;
    let running = true;

    while running {
        let instr = instructions[ip];
        let op = instr[0];

        if op == "PUSH" {
            push(stack, instr[1]);
            ip = ip + 1;
        } 
        else if op == "LOAD" {
            push(stack, env[instr[1]]);
            ip = ip + 1;
        } 
        else if op == "STORE" {
            env[instr[1]] = pop(stack);
            ip = ip + 1;
        } 
        else if op == "ADD" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left + right);
            ip = ip + 1;
        } 
        else if op == "SUB" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left - right);
            ip = ip + 1;
        } 
        else if op == "MUL" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left * right);
            ip = ip + 1;
        } 
        else if op == "DIV" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left / right);
            ip = ip + 1;
        } 
        else if op == "EQ" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left == right);
            ip = ip + 1;
        } 
        else if op == "NEQ" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left != right);
            ip = ip + 1;
        } 
        else if op == "LT" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left < right);
            ip = ip + 1;
        } 
        else if op == "LTEQ" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left <= right);
            ip = ip + 1;
        } 
        else if op == "GT" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left > right);
            ip = ip + 1;
        } 
        else if op == "GTEQ" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left >= right);
            ip = ip + 1;
        } 
        else if op == "JUMP" {
            ip = instr[1];
        } 
        else if op == "JUMP_IF_FALSE" {
            let cond = pop(stack);
            if !cond {
                ip = instr[1];
            } else {
                ip = ip + 1;
            }
        } 
        else if op == "PRINT" {
            print(pop(stack));
            ip = ip + 1;
        } 
        else if op == "HALT" {
            running = false;
        } 
        else {
            throw "Unknown opcode: " + op;
        }
    }
}