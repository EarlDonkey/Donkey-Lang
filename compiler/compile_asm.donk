// compiler/compile_asm.donk
import "lexer.donk";
import "parser.donk";
import "codegen.donk";

if len(args) < 1 {
    print("Usage: donky-native compiler/compile_asm.donk <file.donk>");
} else {
    let path = args[0];
    let src = read_file(path);
    
    let tokens = tokenize(src);
    let ast = parse_program(tokens);
    let asm = compile_to_asm(ast);
    
    write_file("output.asm", asm);
    print("Successfully generated output.asm!");
}