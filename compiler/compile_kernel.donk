import "lexer.donk";
import "parser.donk";
import "codegen_kernel.donk";

if len(args) < 1 {
    print("Usage: compile_kernel.donk <file.donk>");
} else {
    let src = read_file(args[0]);
    let tokens = tokenize(src);
    let ast = parse_program(tokens);
    let output_asm = compile_to_kernel(ast);
    write_file("kernel.asm", output_asm);
    print("Successfully generated kernel.asm!");
}