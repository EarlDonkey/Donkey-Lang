// --- AUTOGENERATED DONKYC BOOTSTRAP ---
// Do not edit this file directly. Edit the files in compiler/ instead.

// --- Begin lib/strings.donk ---
// lib/strings.donk — string helpers built on top of Donky's native strings.
// Import with: import "lib/strings.donk";

// True if s starts with prefix. starts_with("hello", "he") -> true
fn starts_with(s, prefix) -> bool {
    if len(prefix) > len(s) {
        return false;
    }
    let i = 0;
    while i < len(prefix) {
        if s[i] != prefix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// True if s ends with suffix. ends_with("hello", "lo") -> true
fn ends_with(s, suffix) -> bool {
    if len(suffix) > len(s) {
        return false;
    }
    let offset = len(s) - len(suffix);
    let i = 0;
    while i < len(suffix) {
        if s[offset + i] != suffix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Return the substring of s from index start (inclusive) to end (exclusive).
// slice("hello", 1, 4) -> "ell". If end > len(s), clamps to len(s).
fn slice(s, start, end) -> str {
    if start < 0 { start = 0; }
    if end > len(s) { end = len(s); }
    let out = "";
    let i = start;
    while i < end {
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

// Return the index of the first occurrence of needle in haystack,
// or -1 if not found. index_of("hello", "ll") -> 2
fn index_of(haystack, needle) -> num {
    if len(needle) == 0 {
        return 0;
    }
    if len(needle) > len(haystack) {
        return -1;
    }
    let limit = len(haystack) - len(needle);
    let i = 0;
    while i <= limit {
        if slice(haystack, i, i + len(needle)) == needle {
            return i;
        }
        i = i + 1;
    }
    return -1;
}
// --- End lib/strings.donk ---

// --- Begin compiler/lexer.donk ---

// --- Data Structures ---

struct Token {
    type: str,
    lexeme: str,
    literal: any,
    line: num,
    col: num
}

struct LexerState {
    source: str,
    pos: num,
    line: num,
    col: num
}

// --- State Helpers ---

fn at_end(state) -> bool {
    return state["pos"] >= len(state["source"]);
}

fn peek(state, offset) -> str {
    let i = state["pos"] + offset;
    if i >= len(state["source"]) {
        return "";
    }
    return state["source"][i];
}

fn advance(state) -> str {
    let ch = state["source"][state["pos"]];
    state["pos"] = state["pos"] + 1;
    if ch == "\n" {
        state["line"] = state["line"] + 1;
        state["col"] = 1;
    } else {
        state["col"] = state["col"] + 1;
    }
    return ch;
}

// --- Token Readers ---

fn keyword_or_ident(text) -> str {
    if text == "let" { return "LET"; }
    if text == "fn" { return "FN"; }
    if text == "if" { return "IF"; }
    if text == "else" { return "ELSE"; }
    if text == "while" { return "WHILE"; }
    if text == "for" { return "FOR"; }
    if text == "in" { return "IN"; }
    if text == "return" { return "RETURN"; }
    if text == "print" { return "PRINT"; }
    if text == "true" { return "TRUE"; }
    if text == "false" { return "FALSE"; }
    if text == "div" { return "DIV"; }
    if text == "break" { return "BREAK"; }
    if text == "continue" { return "CONTINUE"; }
    if text == "try" { return "TRY"; }
    if text == "catch" { return "CATCH"; }
    if text == "throw" { return "THROW"; }
    if text == "import" { return "IMPORT"; }
    if text == "struct" { return "STRUCT"; }
    return "IDENT";
}

fn read_number(state, first, line, col) -> Token {
    let start = state["pos"] - 1;
    let seen_dot = false;
    if first == "." { seen_dot = true; }

    while !at_end(state) {
        let ch = peek(state, 0);
        if ch >= "0" && ch <= "9" {
            advance(state);
        } else if ch == "." && !seen_dot {
            seen_dot = true;
            advance(state);
        } else {
            break;
        }
    }
    let text = slice(state["source"], start, state["pos"]);
    let lit = num(text);
    return Token { type: "NUMBER", lexeme: text, literal: lit, line: line, col: col };
}

fn read_string(state, first, quote, line, col) -> Token {
    let start = state["pos"] - 1;
    while !at_end(state) && peek(state, 0) != quote {
        if peek(state, 0) == "\\" {
            advance(state); // skip escaped char
        }
        advance(state);
    }
    if at_end(state) {
        throw "unterminated string";
    }
    advance(state); // closing quote
    let text = slice(state["source"], start, state["pos"]);
    let lit = slice(state["source"], start + 1, state["pos"] - 1);
    return Token { type: "STRING", lexeme: text, literal: lit, line: line, col: col };
}

fn read_identifier(state, first, line, col) -> Token {
    let start = state["pos"] - 1;
    while !at_end(state) {
        let ch = peek(state, 0);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            advance(state);
        } else {
            break;
        }
    }
    let text = slice(state["source"], start, state["pos"]);
    let ttype = keyword_or_ident(text);
    let lit = "";
    if ttype == "TRUE" { lit = true; }
    if ttype == "FALSE" { lit = false; }
    return Token { type: ttype, lexeme: text, literal: lit, line: line, col: col };
}

// --- Main Tokenizer ---

fn tokenize(source) -> array {
    let state = LexerState { source: source, pos: 0, line: 1, col: 1 };
    let tokens = [];

    while !at_end(state) {
        let line = state["line"];
        let col = state["col"];
        let ch = advance(state);

        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            continue;
        }

        if ch == "/" && peek(state, 0) == "/" {
            while peek(state, 0) != "\n" && !at_end(state) {
                advance(state);
            }
            continue;
        }

        if ch >= "0" && ch <= "9" {
            push(tokens, read_number(state, ch, line, col));
        } else if ch == "\"" {
            push(tokens, read_string(state, ch, "\"", line, col));
        } else if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_" {
            push(tokens, read_identifier(state, ch, line, col));
        } else {
            let type = "";
            let lex = ch;
            if ch == "+" { type = "PLUS"; }
            else if ch == "-" { type = "MINUS"; }
            else if ch == "*" { type = "STAR"; }
            else if ch == "/" { type = "SLASH"; }
            else if ch == "%" { type = "PERCENT"; }
            else if ch == "(" { type = "LPAREN"; }
            else if ch == ")" { type = "RPAREN"; }
            else if ch == "{" { type = "LBRACE"; }
            else if ch == "}" { type = "RBRACE"; }
            else if ch == "[" { type = "LBRACKET"; }
            else if ch == "]" { type = "RBRACKET"; }
            else if ch == ";" { type = "SEMI"; }
            else if ch == "," { type = "COMMA"; }
            else if ch == ":" { type = "COLON"; }
            else if ch == "." { type = "DOT"; }
            else if ch == "=" {
                if peek(state, 0) == "=" { advance(state); type = "EQEQ"; lex = "=="; }
                else { type = "EQ"; }
            }
            else if ch == "!" {
                if peek(state, 0) == "=" { advance(state); type = "NOTEQ"; lex = "!="; }
                else { type = "BANG"; }
            }
            else if ch == "<" {
                if peek(state, 0) == "=" { advance(state); type = "LTEQ"; lex = "<="; }
                else { type = "LT"; }
            }
            else if ch == ">" {
                if peek(state, 0) == "=" { advance(state); type = "GTEQ"; lex = ">="; }
                else { type = "GT"; }
            }
            else if ch == "&" {
                if peek(state, 0) == "&" { advance(state); type = "AND"; lex = "&&"; }
                else { throw "unexpected &"; }
            }
            else if ch == "|" {
                if peek(state, 0) == "|" { advance(state); type = "OR"; lex = "||"; }
                else { throw "unexpected |"; }
            }
            else {
                throw "unexpected character: " + ch;
            }

            push(tokens, Token { type: type, lexeme: lex, literal: "", line: line, col: col });
        }
    }

    push(tokens, Token { type: "EOF", lexeme: "", literal: "", line: state["line"], col: state["col"] });
    return tokens;
}
// --- End compiler/lexer.donk ---

// --- Begin compiler/parser.donk ---

// --- AST Helpers ---

fn make_node(type, props) -> map {
    let node = { "type": type };
    for k in keys(props) {
        node[k] = props[k];
    }
    return node;
}

// --- Parser State ---

fn new_state(token_list) -> map {
    return { "tokens": token_list, "pos": 0 };
}

fn p_peek(state) -> any {
    let t = state["tokens"];
    let p = state["pos"];
    if p >= len(t) {
        return t[len(t) - 1]; // EOF
    }
    return t[p];
}

fn p_advance(state) -> any {
    let tok = p_peek(state);
    if state["pos"] < len(state["tokens"]) {
        state["pos"] = state["pos"] + 1;
    }
    return tok;
}

fn p_check(state, type) -> bool {
    return p_peek(state).type == type;
}

fn p_match(state, type) -> bool {
    if p_check(state, type) {
        p_advance(state);
        return true;
    }
    return false;
}

fn p_expect(state, type) -> any {
    if p_check(state, type) {
        return p_advance(state);
    }
    let tok = p_peek(state);
    throw "Parse error at " + str(tok.line) + ":" + str(tok.col) + " expected " + type + " but got " + tok.type;
}

// --- Pratt Parser Precedence ---

fn get_infix_bp(type) -> num {
    if type == "OR" { return 1; }
    if type == "AND" { return 2; }
    if type == "EQEQ" || type == "NOTEQ" { return 3; }
    if type == "LT" || type == "LTEQ" || type == "GT" || type == "GTEQ" { return 4; }
    if type == "PLUS" || type == "MINUS" { return 6; }
    if type == "STAR" || type == "SLASH" || type == "PERCENT" || type == "DIV" { return 7; }
    return -1;
}

// --- Expressions ---

fn parse_expr(state, min_bp) -> map {
    let left = parse_prefix(state);

    while true {
        let op_tok = p_peek(state);
        let bp = get_infix_bp(op_tok.type);
        if bp == -1 || bp < min_bp {
            break;
        }
        p_advance(state);
        let right = parse_expr(state, bp + 1);

        left = make_node("Binary", {
            "left": left,
            "op": op_tok.lexeme,
            "right": right,
            "line": op_tok.line,
            "col": op_tok.col
        });
    }

    return left;
}

fn parse_prefix(state) -> map {
    let tok = p_advance(state);

    if tok.type == "NUMBER" {
        return make_node("Number", { "value": tok.literal, "line": tok.line, "col": tok.col });
    }
    if tok.type == "STRING" {
        return make_node("String", { "value": tok.literal, "line": tok.line, "col": tok.col });
    }
    if tok.type == "TRUE" {
        return make_node("Bool", { "value": true, "line": tok.line, "col": tok.col });
    }
    if tok.type == "FALSE" {
        return make_node("Bool", { "value": false, "line": tok.line, "col": tok.col });
    }
    if tok.type == "IDENT" {
        if p_check(state, "LPAREN") {
            p_advance(state);
            let args = [];
            if !p_check(state, "RPAREN") {
                push(args, parse_expr(state, 0));
                while p_match(state, "COMMA") {
                    push(args, parse_expr(state, 0));
                }
            }
            p_expect(state, "RPAREN");
            return make_node("Call", { "callee": tok.lexeme, "args": args, "line": tok.line, "col": tok.col });
        }
        return make_node("Ident", { "name": tok.lexeme, "line": tok.line, "col": tok.col });
    }
    if tok.type == "MINUS" {
        let operand = parse_expr(state, 8);
        return make_node("Unary", { "op": "-", "operand": operand, "line": tok.line, "col": tok.col });
    }
    if tok.type == "BANG" {
        let operand = parse_expr(state, 8);
        return make_node("Unary", { "op": "!", "operand": operand, "line": tok.line, "col": tok.col });
    }
    if tok.type == "LPAREN" {
        let expr = parse_expr(state, 0);
        p_expect(state, "RPAREN");
        return expr;
    }
    if tok.type == "LBRACKET" {
        let elems = [];
        if !p_check(state, "RBRACKET") {
            push(elems, parse_expr(state, 0));
            while p_match(state, "COMMA") {
                push(elems, parse_expr(state, 0));
            }
        }
        p_expect(state, "RBRACKET");
        return make_node("ArrayLit", { "elems": elems, "line": tok.line, "col": tok.col });
    }

    throw "Unexpected token in expression: " + tok.type + " at " + str(tok.line) + ":" + str(tok.col);
}

// --- Statements ---

fn parse_let(state) -> map {
    let tok = p_advance(state);
    let name = p_expect(state, "IDENT");
    p_expect(state, "EQ");
    let value = parse_expr(state, 0);
    p_expect(state, "SEMI");
    return make_node("LetStmt", { "name": name.lexeme, "value": value, "line": tok.line, "col": tok.col });
}

fn parse_print(state) -> map {
    let tok = p_advance(state);
    p_expect(state, "LPAREN");
    let value = parse_expr(state, 0);
    p_expect(state, "RPAREN");
    p_expect(state, "SEMI");
    return make_node("PrintStmt", { "value": value, "line": tok.line, "col": tok.col });
}

fn parse_if(state) -> map {
    let tok = p_advance(state);
    let cond = parse_expr(state, 0);
    let then_block = parse_block(state);
    let else_block = "";
    if p_match(state, "ELSE") {
        else_block = parse_block(state);
    }
    return make_node("IfStmt", {
        "cond": cond, "then": then_block, "else": else_block, "line": tok.line, "col": tok.col
    });
}

fn parse_while(state) -> map {
    let tok = p_advance(state);
    let cond = parse_expr(state, 0);
    let body = parse_block(state);
    return make_node("WhileStmt", { "cond": cond, "body": body, "line": tok.line, "col": tok.col });
}

fn parse_return(state) -> map {
    let tok = p_advance(state);
    if p_match(state, "SEMI") {
        return make_node("ReturnStmt", { "value": "", "line": tok.line, "col": tok.col });
    }
    let value = parse_expr(state, 0);
    p_expect(state, "SEMI");
    return make_node("ReturnStmt", { "value": value, "line": tok.line, "col": tok.col });
}

fn parse_block(state) -> map {
    let tok = p_expect(state, "LBRACE");
    let stmts = [];
    while !p_check(state, "RBRACE") && !p_check(state, "EOF") {
        push(stmts, parse_statement(state));
    }
    p_expect(state, "RBRACE");
    return make_node("Block", { "stmts": stmts, "line": tok.line, "col": tok.col });
}

fn parse_expr_stmt(state) -> map {
    let tok = p_peek(state);
    let next_tok = state["tokens"][state["pos"] + 1];
    if tok.type == "IDENT" && next_tok.type == "EQ" {
        let name = p_advance(state).lexeme;
        p_advance(state); // =
        let value = parse_expr(state, 0);
        p_expect(state, "SEMI");
        return make_node("AssignStmt", { "name": name, "value": value, "line": tok.line, "col": tok.col });
    }

    let expr = parse_expr(state, 0);
    p_expect(state, "SEMI");
    return make_node("ExprStmt", { "expr": expr, "line": tok.line, "col": tok.col });
}

fn parse_statement(state) -> map {
    if p_check(state, "LET")    { return parse_let(state); }
    if p_check(state, "PRINT")  { return parse_print(state); }
    if p_check(state, "IF")     { return parse_if(state); }
    if p_check(state, "WHILE")  { return parse_while(state); }
    if p_check(state, "RETURN") { return parse_return(state); }
    if p_check(state, "LBRACE") { return parse_block(state); }
    return parse_expr_stmt(state);
}

fn parse_program(token_list) -> map {
    let state = new_state(token_list);
    let stmts = [];
    while !p_check(state, "EOF") {
        push(stmts, parse_statement(state));
    }
    return make_node("Program", { "stmts": stmts });
}
// --- End compiler/parser.donk ---

// --- Begin compiler/interpreter.donk ---

// --- Environments ---

fn new_env(parent) -> map {
    return { "vars": {}, "parent": parent };
}

fn env_get(env, name) -> any {
    let vars = env["vars"];
    if contains(vars, name) {
        return vars[name];
    }
    if env["parent"] != "" {
        return env_get(env["parent"], name);
    }
    throw "Undefined variable: " + name;
}

fn env_set(env, name, value) -> void {
    let vars = env["vars"];
    if contains(vars, name) {
        vars[name] = value;
        return;
    }
    if env["parent"] != "" {
        env_set(env["parent"], name, value);
        return;
    }
    throw "Assignment to undefined variable: " + name;
}

fn env_define(env, name, value) -> void {
    let vars = env["vars"];
    vars[name] = value;
}

fn is_return(node) -> bool {
    return type(node) == "map" && contains(node, "type") && node["type"] == "Return";
}

// --- Expressions ---

fn eval_expr(node, env) -> any {
    let t = node["type"];

    if t == "Number" { return node["value"]; }
    if t == "String" { return node["value"]; }
    if t == "Bool"   { return node["value"]; }
    if t == "Ident"  { return env_get(env, node["name"]); }

    if t == "Binary" {
        let left = eval_expr(node["left"], env);
        let right = eval_expr(node["right"], env);
        let op = node["op"];

        if op == "+" {
            if type(left) == "string" || type(right) == "string" {
                return str(left) + str(right);
            }
            return left + right;
        }
        if op == "-" { return left - right; }
        if op == "*" { return left * right; }
        if op == "/" { return left / right; }
        if op == "%" { return left % right; }
        if op == "==" { return left == right; }
        if op == "!=" { return left != right; }
        if op == "<"  { return left < right; }
        if op == "<=" { return left <= right; }
        if op == ">"  { return left > right; }
        if op == ">=" { return left >= right; }
        if op == "&&" { return left && right; }
        if op == "||" { return left || right; }
    }

    if t == "Unary" {
        let val = eval_expr(node["operand"], env);
        if node["op"] == "-" { return -val; }
        if node["op"] == "!" { return !val; }
    }

    if t == "Call" {
        let callee = node["callee"];
        let args = [];
        for arg in node["args"] {
            push(args, eval_expr(arg, env));
        }

        // Builtins
        if callee == "print" {
            let out = "";
            for a in args { out = out + str(a) + " "; }
            print(out);
            return "";
        }
        if callee == "len"  { return len(args[0]); }
        if callee == "str"  { return str(args[0]); }
        if callee == "num"  { return num(args[0]); }
        if callee == "type" { return type(args[0]); }

        // User function
        let callee_fn = env_get(env, callee);
        if callee_fn == "" { throw "Not a function: " + callee; }

        let call_env = new_env(callee_fn["closure"]);
        let i = 0;
        while i < len(args) {
            env_define(call_env, callee_fn["params"][i], args[i]);
            i = i + 1;
        }

        let result = "";
        for s in callee_fn["body"] {
            result = exec_stmt(s, call_env);
            if is_return(result) {
                return result["value"];
            }
        }
        return "";
    }

    throw "Cannot evaluate expression: " + t;
}

// --- Statements ---

fn exec_stmt(node, env) -> any {
    let t = node["type"];

    if t == "Program" {
        for s in node["stmts"] {
            let res = exec_stmt(s, env);
            if is_return(res) { return res; }
        }
        return "";
    }

    if t == "LetStmt" {
        let val = eval_expr(node["value"], env);
        env_define(env, node["name"], val);
        return "";
    }

    if t == "AssignStmt" {
        let val = eval_expr(node["value"], env);
        env_set(env, node["name"], val);
        return "";
    }

    if t == "PrintStmt" {
        let val = eval_expr(node["value"], env);
        print(val);
        return "";
    }

    if t == "ExprStmt" {
        eval_expr(node["expr"], env);
        return "";
    }

    if t == "ReturnStmt" {
        let val = eval_expr(node["value"], env);
        return { "type": "Return", "value": val };
    }

    if t == "Block" {
        let block_env = new_env(env);
        for s in node["stmts"] {
            let res = exec_stmt(s, block_env);
            if is_return(res) { return res; }
        }
        return "";
    }

    if t == "IfStmt" {
        let cond = eval_expr(node["cond"], env);
        if cond {
            return exec_stmt(node["then"], env);
        } else if node["else"] != "" {
            return exec_stmt(node["else"], env);
        }
        return "";
    }

    if t == "WhileStmt" {
        while eval_expr(node["cond"], env) {
            let res = exec_stmt(node["body"], env);
            if is_return(res) { return res; }
        }
        return "";
    }

    throw "Cannot execute statement: " + t;
}
// --- End compiler/interpreter.donk ---

// --- Begin compiler/bytecode_compiler.donk ---
fn emit(instructions, op) -> num {
    push(instructions, [op]);
    return len(instructions) - 1;
}

fn emit_arg(instructions, op, arg) -> num {
    push(instructions, [op, arg]);
    return len(instructions) - 1;
}

fn patch_jump(instructions, idx) -> void {
    // Break the chained index assignment into two steps
    let instr = instructions[idx];
    instr[1] = len(instructions);
}

fn compile_expr(node, instructions) -> void {
    let t = node["type"];

    if t == "Number" || t == "String" || t == "Bool" {
        emit_arg(instructions, "PUSH", node["value"]);
    }

    if t == "Ident" {
        emit_arg(instructions, "LOAD", node["name"]);
    }

    if t == "Binary" {
        compile_expr(node["left"], instructions);
        compile_expr(node["right"], instructions);
        let op = node["op"];
        if op == "+" { emit(instructions, "ADD"); }
        if op == "-" { emit(instructions, "SUB"); }
        if op == "*" { emit(instructions, "MUL"); }
        if op == "/" { emit(instructions, "DIV"); }
        if op == "==" { emit(instructions, "EQ"); }
        if op == "!=" { emit(instructions, "NEQ"); }
        if op == "<" { emit(instructions, "LT"); }
        if op == "<=" { emit(instructions, "LTEQ"); }
        if op == ">" { emit(instructions, "GT"); }
        if op == ">=" { emit(instructions, "GTEQ"); }
    }
}

fn compile_stmt(node, instructions) -> void {
    let t = node["type"];

    if t == "LetStmt" || t == "AssignStmt" {
        compile_expr(node["value"], instructions);
        emit_arg(instructions, "STORE", node["name"]);
    }

    if t == "PrintStmt" {
        compile_expr(node["value"], instructions);
        emit(instructions, "PRINT");
    }

    if t == "IfStmt" {
        compile_expr(node["cond"], instructions);
        let jf_idx = emit_arg(instructions, "JUMP_IF_FALSE", 0);

        compile_stmt(node["then"], instructions);

        if node["else"] != "" {
            let j_idx = emit_arg(instructions, "JUMP", 0);
            patch_jump(instructions, jf_idx);
            compile_stmt(node["else"], instructions);
            patch_jump(instructions, j_idx);
        } else {
            patch_jump(instructions, jf_idx);
        }
    }

    if t == "WhileStmt" {
        let loop_start = len(instructions);
        compile_expr(node["cond"], instructions);
        let jf_idx = emit_arg(instructions, "JUMP_IF_FALSE", 0);

        compile_stmt(node["body"], instructions);

        emit_arg(instructions, "JUMP", loop_start);
        patch_jump(instructions, jf_idx);
    }

    if t == "Block" {
        for s in node["stmts"] {
            compile_stmt(s, instructions);
        }
    }
}

fn compile_ast(ast) -> array {
    let instructions = [];
    for s in ast["stmts"] {
        compile_stmt(s, instructions);
    }
    push(instructions, ["HALT"]);
    return instructions;
}
// --- End compiler/bytecode_compiler.donk ---

// --- Begin compiler/bytecode_vm.donk ---
fn run_bytecode(instructions) -> void {
    let stack = [];
    let env = {};
    let ip = 0;
    let running = true;

    while running {
        let instr = instructions[ip];
        let op = instr[0];

        if op == "PUSH" {
            push(stack, instr[1]);
            ip = ip + 1;
        }
        else if op == "LOAD" {
            push(stack, env[instr[1]]);
            ip = ip + 1;
        }
        else if op == "STORE" {
            env[instr[1]] = pop(stack);
            ip = ip + 1;
        }
        else if op == "ADD" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left + right);
            ip = ip + 1;
        }
        else if op == "SUB" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left - right);
            ip = ip + 1;
        }
        else if op == "MUL" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left * right);
            ip = ip + 1;
        }
        else if op == "DIV" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left / right);
            ip = ip + 1;
        }
        else if op == "EQ" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left == right);
            ip = ip + 1;
        }
        else if op == "NEQ" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left != right);
            ip = ip + 1;
        }
        else if op == "LT" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left < right);
            ip = ip + 1;
        }
        else if op == "LTEQ" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left <= right);
            ip = ip + 1;
        }
        else if op == "GT" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left > right);
            ip = ip + 1;
        }
        else if op == "GTEQ" {
            let right = pop(stack);
            let left = pop(stack);
            push(stack, left >= right);
            ip = ip + 1;
        }
        else if op == "JUMP" {
            ip = instr[1];
        }
        else if op == "JUMP_IF_FALSE" {
            let cond = pop(stack);
            if !cond {
                ip = instr[1];
            } else {
                ip = ip + 1;
            }
        }
        else if op == "PRINT" {
            print(pop(stack));
            ip = ip + 1;
        }
        else if op == "HALT" {
            running = false;
        }
        else {
            throw "Unknown opcode: " + op;
        }
    }
}
// --- End compiler/bytecode_vm.donk ---


// --- Main Entry Point ---
if len(args) < 2 {
    print("Usage: donkyc <run|compile> <file.donk>");
} else {
    let cmd = args[0];
    let path = args[1];
    let src = read_file(path);
    
    try {
        let tokens = tokenize(src);
        let ast = parse_program(tokens);
        
        if cmd == "run" {
            let global_env = new_env("");
            exec_stmt(ast, global_env);
        } else if cmd == "compile" {
            let bytecode = compile_ast(ast);
            let json_str = to_json(bytecode);
            write_file(path + ".json", json_str);
            print("Compiled to " + path + ".json");
        } else {
            print("Unknown command: " + cmd);
        }
    } catch e {
        print("Error: " + e);
    }
}
