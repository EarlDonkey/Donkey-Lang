// compiler/codegen.donk

fn new_codegen_state() -> map {
    return { 
        "output": "", 
        "variables": {}, 
        "variable_types": {}, 
        "strings": [], 
        "next_slot": 0, 
        "label_count": 0 
    };
}

fn emit(state, line) -> void {
    state["output"] = state["output"] + line + "\n";
}

fn new_label(state) -> str {
    let l = "L" + str(state["label_count"]);
    state["label_count"] = state["label_count"] + 1;
    return l;
}

fn gen_expr(state, node) -> str {
    let t = node["type"];
    
    if t == "Number" {
        emit(state, "    mov rax, " + str(node["value"]));
        return "num";
    } 
    
    if t == "String" {
        let idx = len(state["strings"]);
        push(state["strings"], node["value"]);
        emit(state, "    lea rax, [rel str_" + str(idx) + "]");
        return "str";
    }
    
    if t == "Bool" {
        if node["value"] { emit(state, "    mov rax, 1"); } 
        else { emit(state, "    mov rax, 0"); }
        return "num";
    }
    
    if t == "Ident" {
        let name = node["name"];
        let vars = state["variables"];
        let offset = 0;
        if contains(vars, name) {
            offset = vars[name];
        }
        emit(state, "    mov rax, [rbp - " + str(offset) + "]");
        return "num";
    }
    
    if t == "Unary" {
        gen_expr(state, node["operand"]);
        if node["op"] == "-" { emit(state, "    neg rax"); }
        return "num";
    }
    
    if t == "Binary" {
        let lt = gen_expr(state, node["left"]);
        emit(state, "    push rax");
        let rt = gen_expr(state, node["right"]);
        emit(state, "    pop rcx");
        
        let op = node["op"];
        if op == "+" {
            if lt == "str" && rt == "str" { emit(state, "    ; TODO: str concat"); return "str"; }
            emit(state, "    add rax, rcx");
            return "num";
        } else if op == "-" {
            emit(state, "    sub rcx, rax");
            emit(state, "    mov rax, rcx");
            return "num";
        } else if op == "*" {
            emit(state, "    imul rax, rcx");
            return "num";
        } else if op == "/" || op == "div" {
            emit(state, "    mov rbx, rax");
            emit(state, "    mov rax, rcx");
            emit(state, "    cqo");
            emit(state, "    idiv rbx");
            return "num";
        } else if op == "==" {
            emit(state, "    cmp rcx, rax");
            emit(state, "    sete al");
            emit(state, "    movzx rax, al");
            return "num";
        } else if op == "<" {
            emit(state, "    cmp rcx, rax");
            emit(state, "    setl al");
            emit(state, "    movzx rax, al");
            return "num";
        } else if op == ">" {
            emit(state, "    cmp rcx, rax");
            emit(state, "    setg al");
            emit(state, "    movzx rax, al");
            return "num";
        }
        return "num";
    }
    
    if t == "Call" {
        let name = node["callee"];
        let args = node["args"];
        
        let i = 0;
        while i < len(args) {
            gen_expr(state, args[i]);
            emit(state, "    push rax");
            i = i + 1;
        }
        
        let arg_regs = ["rcx", "rdx", "r8", "r9"];
        let i = len(args) - 1;
        while i >= 0 {
            emit(state, "    pop " + arg_regs[i]);
            i = i - 1;
        }
        
        emit(state, "    sub rsp, 32");
        emit(state, "    call " + name);
        emit(state, "    add rsp, 32");
        return "num";
    }
    
    return "num";
}

fn gen_stmt(state, node) -> void {
    let t = node["type"];
    
    if t == "LetStmt" {
        let vt = gen_expr(state, node["value"]);
        let offset = state["next_slot"] * 8 + 8;
        state["next_slot"] = state["next_slot"] + 1;
        
        let vars = state["variables"];
        let types = state["variable_types"];
        vars[node["name"]] = offset;
        types[node["name"]] = vt;
        
        emit(state, "    mov [rbp - " + str(offset) + "], rax");
    } else if t == "AssignStmt" {
        gen_expr(state, node["value"]);
        let offset = state["variables"][node["name"]];
        emit(state, "    mov [rbp - " + str(offset) + "], rax");
    } else if t == "PrintStmt" {
        let vt = gen_expr(state, node["value"]);
        emit(state, "    mov rdx, rax");
        if vt == "str" { emit(state, "    lea rcx, [rel fmt_str]"); } 
        else { emit(state, "    lea rcx, [rel fmt_int]"); }
        emit(state, "    sub rsp, 32");
        emit(state, "    call printf");
        emit(state, "    add rsp, 32");
    } else if t == "IfStmt" {
        let else_label = new_label(state);
        let end_label = new_label(state);
        
        gen_expr(state, node["cond"]);
        emit(state, "    cmp rax, 0");
        emit(state, "    je " + else_label);
        
        gen_stmt(state, node["then"]);
        emit(state, "    jmp " + end_label);
        
        emit(state, else_label + ":");
        if node["else"] != "" { gen_stmt(state, node["else"]); }
        emit(state, end_label + ":");
    } else if t == "WhileStmt" {
        let start_label = new_label(state);
        let end_label = new_label(state);
        
        emit(state, start_label + ":");
        gen_expr(state, node["cond"]);
        emit(state, "    cmp rax, 0");
        emit(state, "    je " + end_label);
        
        gen_stmt(state, node["body"]);
        emit(state, "    jmp " + start_label);
        emit(state, end_label + ":");
    } else if t == "ReturnStmt" {
        if node["value"] != "" { gen_expr(state, node["value"]); } 
        else { emit(state, "    mov rax, 0"); }
        emit(state, "    leave");
        emit(state, "    ret");
    } else if t == "Block" {
        for s in node["stmts"] { gen_stmt(state, s); }
    }
}

fn gen_function(state, func) -> void {
    let name = func["name"];
    let params = func["params"];
    let body = func["body"];
    
    let saved_vars = state["variables"];
    let saved_types = state["variable_types"];
    let saved_slot = state["next_slot"];
    
    state["variables"] = {};
    state["variable_types"] = {};
    state["next_slot"] = 0;
    
    emit(state, "");
    emit(state, name + ":");
    emit(state, "    push rbp");
    emit(state, "    mov rbp, rsp");
    emit(state, "    sub rsp, 256");
    
    let arg_regs = ["rcx", "rdx", "r8", "r9"];
    let i = 0;
    while i < len(params) {
        let offset = state["next_slot"] * 8 + 8;
        state["next_slot"] = state["next_slot"] + 1;
        
        let vars = state["variables"];
        vars[params[i]] = offset;
        
        emit(state, "    mov [rbp - " + str(offset) + "], " + arg_regs[i]);
        i = i + 1;
    }
    
    for s in body["stmts"] { gen_stmt(state, s); }
    
    emit(state, "    mov rax, 0");
    emit(state, "    leave");
    emit(state, "    ret");
    
    state["variables"] = saved_vars;
    state["variable_types"] = saved_types;
    state["next_slot"] = saved_slot;
}

fn compile_to_asm(ast) -> str {
    let state = new_codegen_state();
    
    emit(state, "bits 64");
    emit(state, "default rel");
    emit(state, "extern printf");
    emit(state, "extern ExitProcess");
    emit(state, "extern net_init");     // <--- ADD
    emit(state, "extern net_connect");  // <--- ADD
    emit(state, "extern net_close");
    emit(state, "global main");
    emit(state, "");
    emit(state, "section .text");
    emit(state, "main:");
    emit(state, "    push rbp");
    emit(state, "    mov rbp, rsp");
    emit(state, "    sub rsp, 1024");
    
    let functions = [];
    let main_stmts = [];
    for stmt in ast["stmts"] {
        if stmt["type"] == "FnStmt" {
            push(functions, stmt);
        } else {
            push(main_stmts, stmt);
        }
    }
    
    for stmt in main_stmts { gen_stmt(state, stmt); }
    
    emit(state, "    xor ecx, ecx");
    emit(state, "    call ExitProcess");
    emit(state, "    leave");
    emit(state, "    ret");
    
    for func in functions { gen_function(state, func); }
    
    let data = "\nsection .data\n    fmt_int db '%d', 10, 0\n    fmt_str db '%s', 10, 0\n";
    let i = 0;
    while i < len(state["strings"]) {
        let s = state["strings"][i];
        let bytes = [];
        let j = 0;
        while j < len(s) {
            push(bytes, str(char_code(s[j])));
            j = j + 1;
        }
        push(bytes, "0");
        data = data + "    str_" + str(i) + " db " + join(bytes, ", ") + "\n";
        i = i + 1;
    }
    
    return state["output"] + data;
}