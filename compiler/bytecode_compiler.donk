fn emit(instructions, op) -> num {
    push(instructions, [op]);
    return len(instructions) - 1;
}

fn emit_arg(instructions, op, arg) -> num {
    push(instructions, [op, arg]);
    return len(instructions) - 1;
}

fn patch_jump(instructions, idx) -> void {
    // Break the chained index assignment into two steps
    let instr = instructions[idx];
    instr[1] = len(instructions);
}

fn compile_expr(node, instructions) -> void {
    let t = node["type"];
    
    if t == "Number" || t == "String" || t == "Bool" {
        emit_arg(instructions, "PUSH", node["value"]);
    }
    
    if t == "Ident" {
        emit_arg(instructions, "LOAD", node["name"]);
    }
    
    if t == "Binary" {
        compile_expr(node["left"], instructions);
        compile_expr(node["right"], instructions);
        let op = node["op"];
        if op == "+" { emit(instructions, "ADD"); }
        if op == "-" { emit(instructions, "SUB"); }
        if op == "*" { emit(instructions, "MUL"); }
        if op == "/" { emit(instructions, "DIV"); }
        if op == "==" { emit(instructions, "EQ"); }
        if op == "!=" { emit(instructions, "NEQ"); }
        if op == "<" { emit(instructions, "LT"); }
        if op == "<=" { emit(instructions, "LTEQ"); }
        if op == ">" { emit(instructions, "GT"); }
        if op == ">=" { emit(instructions, "GTEQ"); }
    }
}

fn compile_stmt(node, instructions) -> void {
    let t = node["type"];
    
    if t == "LetStmt" || t == "AssignStmt" {
        compile_expr(node["value"], instructions);
        emit_arg(instructions, "STORE", node["name"]);
    }
    
    if t == "PrintStmt" {
        compile_expr(node["value"], instructions);
        emit(instructions, "PRINT");
    }
    
    if t == "IfStmt" {
        compile_expr(node["cond"], instructions);
        let jf_idx = emit_arg(instructions, "JUMP_IF_FALSE", 0);
        
        compile_stmt(node["then"], instructions);
        
        if node["else"] != "" {
            let j_idx = emit_arg(instructions, "JUMP", 0);
            patch_jump(instructions, jf_idx);
            compile_stmt(node["else"], instructions);
            patch_jump(instructions, j_idx);
        } else {
            patch_jump(instructions, jf_idx);
        }
    }
    
    if t == "WhileStmt" {
        let loop_start = len(instructions);
        compile_expr(node["cond"], instructions);
        let jf_idx = emit_arg(instructions, "JUMP_IF_FALSE", 0);
        
        compile_stmt(node["body"], instructions);
        
        emit_arg(instructions, "JUMP", loop_start);
        patch_jump(instructions, jf_idx);
    }
    
    if t == "Block" {
        for s in node["stmts"] {
            compile_stmt(s, instructions);
        }
    }
}

fn compile_ast(ast) -> array {
    let instructions = [];
    for s in ast["stmts"] {
        compile_stmt(s, instructions);
    }
    push(instructions, ["HALT"]);
    return instructions;
}