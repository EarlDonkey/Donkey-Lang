print("Donky OS Shell v2.4 (DonkyFS)");
print_newline();
print_newline();

let buf = alloc(128);
let disk_buf = alloc(512);

while 1 == 1 {
    print("root@donky:~# ");
    read_line(buf);

    if str_eq(buf, "help") == 1 {
        print("Commands: help, clear, reboot, shutdown, ls, touch <name>, rm, mkfs");
        print_newline();
    } else if str_eq(buf, "clear") == 1 {
        clear_screen();
        print("Donky OS Shell v2.4 (DonkyFS)");
        print_newline();
    } else if str_eq(buf, "reboot") == 1 {
        print("Rebooting...");
        reboot();
    } else if str_eq(buf, "shutdown") == 1 {
        print("Shutting down...");
        shutdown();
    } else if str_eq(buf, "mkfs") == 1 {
        print("Formatting DonkyFS...");
        let i = 0;
        while i < 512 {
            mem_write8(disk_buf + i, 0);
            i = i + 1;
        }
        disk_write(1, disk_buf);
        print("Formatted Sector 1.");
        print_newline();
    } else if str_eq(buf, "ls") == 1 {
        disk_read(1, disk_buf);
        print("--- Directory ---");
        print_newline();
        print_str(disk_buf);
        print("-----------------");
        print_newline();
    } else if str_starts_with(buf, "touch ") == 1 {
        let fname = str_skip(buf, 6);
        disk_read(1, disk_buf);
        
        let i = 0;
        while i < 512 {
            if mem_read8(disk_buf + i) == 0 { break; }
            i = i + 1;
        }
        
        str_copy(disk_buf + i, fname);
        
        let j = 0;
        while j < 512 {
            if mem_read8(disk_buf + i + j) == 0 { break; }
            j = j + 1;
        }
        
        mem_write8(disk_buf + i + j, 10);
        mem_write8(disk_buf + i + j + 1, 0);
        
        disk_write(1, disk_buf);
        print("Created file: ");
        print_str(fname);
        print_newline();
    } else if str_eq(buf, "rm") == 1 {
        print("Clearing Directory...");
        let i = 0;
        while i < 512 {
            mem_write8(disk_buf + i, 0);
            i = i + 1;
        }
        disk_write(1, disk_buf);
        print("Directory cleared.");
        print_newline();
    } else if str_eq(buf, "") == 1 {
        // Empty enter
    } else {
        print("command not found: ");
        print_str(buf);
        print_newline();
    }
}