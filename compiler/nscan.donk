// compiler/nscan.donk

net_init();

print("--- Native Donky Scanner ---");
print("Scanning 127.0.0.1...");

let port = 80;
while port <= 82 {
    let sock = net_connect("127.0.0.1", port);
    if sock != -1 {
        print(port);
        net_close(sock);
    }
    port = port + 1;
}

print("Scan complete.");