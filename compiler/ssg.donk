// compiler/ssg.donk
import "../lib/strings.donk";
import "markdown.donk";

fn build_site() -> void {
    mkdir("public");
    
    let files = list_dir("content");
    
    // 1. Build the sidebar navigation
    let nav = "<ul>\n";
    for file in files {
        if ends_with(file, ".md") {
            let title = split(file, ".")[0];
            nav = nav + "<li><a href=\"" + title + ".html\">" + title + "</a></li>\n";
        }
    }
    nav = nav + "</ul>\n";

    // 2. Generate each page
    for file in files {
        if ends_with(file, ".md") {
            print("Processing: " + file);
            
            let md = read_file("content/" + file);
            let body = parse_markdown(md);
            let title = split(file, ".")[0];
            
            let html = "<!DOCTYPE html>\n<html>\n<head>\n";
            html = html + "<title>" + title + "</title>\n";
            // Added Flexbox CSS for the sidebar layout
            html = html + "<style>body{font-family:sans-serif;margin:0;line-height:1.6;background:#1e1e1e;color:#d4d4d4;display:flex;} nav{width:200px;padding:20px;background:#2d2d2d;height:100vh;position:sticky;top:0;} main{flex:1;padding:40px;max-width:800px;} a{color:#4ec9b0;text-decoration:none;} a:hover{text-decoration:underline;} h1{color:#ce9178;} pre{background:#111;padding:15px;border-radius:5px;overflow-x:auto;} code{font-family:monospace;}</style>\n";
            html = html + "</head>\n<body>\n";
            html = html + "<nav>" + nav + "</nav>\n";
            html = html + "<main>" + body + "</main>\n";
            html = html + "</body>\n</html>";
            
            let out_name = title + ".html";
            write_file("public/" + out_name, html);
        }
    }
    print("Site built successfully in /public!");
}

build_site();