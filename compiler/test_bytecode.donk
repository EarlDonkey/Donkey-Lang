import "lexer.donk";
import "parser.donk";
import "bytecode_compiler.donk";
import "bytecode_vm.donk";

let source = "
let x = 10;
let y = 20;
print(x + y);

let i = 0;
while i < 3 {
    print(i);
    i = i + 1;
}
";

print("--- Compiling to Bytecode ---");
let tokens = tokenize(source);
let ast = parse_program(tokens);
let bytecode = compile_ast(ast);

print("--- Generated Bytecode ---");
for instr in bytecode {
    print(instr);
}

print("\n--- Running VM ---");
run_bytecode(bytecode);