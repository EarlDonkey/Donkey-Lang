// ============================================================================
// DONK ENGINE v2.0 - FULL SELF-HOSTING INTERPRETER
// Includes: Full Lexer, Recursive Descent Precedence Parser, Scope Stack & Functions
// ============================================================================

struct Token {
    ttype: string,
    lexeme: string,
    line: number
}

// ----------------------------------------------------------------------------
// 1. LEXER ENGINE
// ----------------------------------------------------------------------------
fn is_alpha(code) -> bool {
    return (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95;
}

fn is_digit(code) -> bool {
    return code >= 48 && code <= 57;
}

fn lex_source(source) -> array {
    let tokens = [];
    let pos = 0;
    let total_len = len(source);
    let line = 1;

    while pos < total_len {
        let b = byte_at(source, pos);

        // Skip Whitespace
        if b == 32 || b == 9 || b == 13 { pos += 1; continue; }
        if b == 10 { pos += 1; line += 1; continue; }

        // Skip Comments
        if b == 47 && pos + 1 < total_len && byte_at(source, pos + 1) == 47 {
            while pos < total_len && byte_at(source, pos) != 10 { pos += 1; }
            continue;
        }

        let start_pos = pos;

        // Keywords & Identifiers
        if is_alpha(b) {
            while pos < total_len && (is_alpha(byte_at(source, pos)) || is_digit(byte_at(source, pos))) { pos += 1; }
            let text = byte_substr(source, start_pos, pos);
            let ttype = "IDENT";

            match text {
                "let" { ttype = "LET"; }
                "fn" { ttype = "FN"; }
                "if" { ttype = "IF"; }
                "else" { ttype = "ELSE"; }
                "while" { ttype = "WHILE"; }
                "return" { ttype = "RETURN"; }
                "print" { ttype = "PRINT"; }
                "true" { ttype = "TRUE"; }
                "false" { ttype = "FALSE"; }
                _ { ttype = "IDENT"; }
            }
            push(tokens, Token { ttype: ttype, lexeme: text, line: line });
            continue;
        }

        // Numbers
        if is_digit(b) {
            while pos < total_len && (is_digit(byte_at(source, pos)) || byte_at(source, pos) == 46) { pos += 1; }
            let text = byte_substr(source, start_pos, pos);
            push(tokens, Token { ttype: "NUMBER", lexeme: text, line: line });
            continue;
        }

        // Strings
        if b == 34 {
            pos += 1;
            let str_start = pos;
            while pos < total_len && byte_at(source, pos) != 34 { pos += 1; }
            let text = byte_substr(source, str_start, pos);
            pos += 1;
            push(tokens, Token { ttype: "STRING", lexeme: text, line: line });
            continue;
        }

        // Delimiters & Operators
        let char_str = byte_substr(source, pos, pos + 1);
        pos += 1;
        let ttype = "SYMBOL";

        match char_str {
            "(" { ttype = "LPAREN"; }
            ")" { ttype = "RPAREN"; }
            "{" { ttype = "LBRACE"; }
            "}" { ttype = "RBRACE"; }
            ";" { ttype = "SEMI"; }
            "," { ttype = "COMMA"; }
            "+" { ttype = "PLUS"; }
            "-" { ttype = "MINUS"; }
            "*" { ttype = "STAR"; }
            "/" { ttype = "SLASH"; }
            "=" {
                if pos < total_len && byte_at(source, pos) == 61 {
                    pos += 1; char_str = "=="; ttype = "EQEQ";
                } else { ttype = "EQ"; }
            }
            "!" {
                if pos < total_len && byte_at(source, pos) == 61 {
                    pos += 1; char_str = "!="; ttype = "NOTEQ";
                } else { ttype = "BANG"; }
            }
            "<" {
                if pos < total_len && byte_at(source, pos) == 61 {
                    pos += 1; char_str = "<="; ttype = "LTEQ";
                } else { ttype = "LT"; }
            }
            ">" {
                if pos < total_len && byte_at(source, pos) == 61 {
                    pos += 1; char_str = ">="; ttype = "GTEQ";
                } else { ttype = "GT"; }
            }
            _ { ttype = "UNKNOWN"; }
        }
        push(tokens, Token { ttype: ttype, lexeme: char_str, line: line });
    }

    push(tokens, Token { ttype: "EOF", lexeme: "", line: line });
    return tokens;
}

// ----------------------------------------------------------------------------
// 2. RECURSIVE DESCENT PARSER (AST GENERATOR)
// ----------------------------------------------------------------------------
fn new_parser(tokens) -> map {
    return { "tokens": tokens, "current": 0 };
}

fn peek(p) -> map {
    return p["tokens"][p["current"]];
}

fn advance(p) -> map {
    let tok = p["tokens"][p["current"]];
    p["current"] = p["current"] + 1;
    return tok;
}

fn check(p, ttype) -> bool {
    return peek(p).ttype == ttype;
}

fn match_type(p, ttype) -> bool {
    if check(p, ttype) {
        advance(p);
        return true;
    }
    return false;
}

fn parse_primary(p) -> map {
    let tok = peek(p);

    if match_type(p, "NUMBER") {
        return { "type": "Number", "val": num(tok.lexeme) };
    }
    if match_type(p, "STRING") {
        return { "type": "String", "val": tok.lexeme };
    }
    if match_type(p, "TRUE") { return { "type": "Bool", "val": true }; }
    if match_type(p, "FALSE") { return { "type": "Bool", "val": false }; }

    if match_type(p, "IDENT") {
        let name = tok.lexeme;
        // Function Call Expression
        if match_type(p, "LPAREN") {
            let args = [];
            if !check(p, "RPAREN") {
                push(args, parse_expr(p));
                while match_type(p, "COMMA") {
                    push(args, parse_expr(p));
                }
            }
            match_type(p, "RPAREN");
            return { "type": "Call", "name": name, "args": args };
        }
        return { "type": "Ident", "name": name };
    }

    if match_type(p, "LPAREN") {
        let expr = parse_expr(p);
        match_type(p, "RPAREN");
        return expr;
    }

    advance(p);
    return { "type": "Null" };
}

fn parse_multiplicative(p) -> map {
    let expr = parse_primary(p);
    while check(p, "STAR") || check(p, "SLASH") {
        let op = advance(p).lexeme;
        let right = parse_primary(p);
        expr = { "type": "Binary", "left": expr, "op": op, "right": right };
    }
    return expr;
}

fn parse_additive(p) -> map {
    let expr = parse_multiplicative(p);
    while check(p, "PLUS") || check(p, "MINUS") {
        let op = advance(p).lexeme;
        let right = parse_multiplicative(p);
        expr = { "type": "Binary", "left": expr, "op": op, "right": right };
    }
    return expr;
}

fn parse_comparison(p) -> map {
    let expr = parse_additive(p);
    while check(p, "LT") || check(p, "GT") || check(p, "LTEQ") || check(p, "GTEQ") || check(p, "EQEQ") || check(p, "NOTEQ") {
        let op = advance(p).lexeme;
        let right = parse_additive(p);
        expr = { "type": "Binary", "left": expr, "op": op, "right": right };
    }
    return expr;
}

fn parse_expr(p) -> map {
    return parse_comparison(p);
}

fn parse_statement(p) -> map {
    if match_type(p, "LET") {
        let name = advance(p).lexeme;
        match_type(p, "EQ");
        let val = parse_expr(p);
        match_type(p, "SEMI");
        return { "type": "Let", "name": name, "value": val };
    }

    if match_type(p, "PRINT") {
        match_type(p, "LPAREN");
        let val = parse_expr(p);
        match_type(p, "RPAREN");
        match_type(p, "SEMI");
        return { "type": "Print", "value": val };
    }

    if match_type(p, "IF") {
        let cond = parse_expr(p);
        match_type(p, "LBRACE");
        let then_branch = parse_block(p);
        let else_branch = [];
        if match_type(p, "ELSE") {
            match_type(p, "LBRACE");
            else_branch = parse_block(p);
        }
        return { "type": "If", "cond": cond, "then": then_branch, "else": else_branch };
    }

    if match_type(p, "WHILE") {
        let cond = parse_expr(p);
        match_type(p, "LBRACE");
        let body = parse_block(p);
        return { "type": "While", "cond": cond, "body": body };
    }

    if match_type(p, "FN") {
        let name = advance(p).lexeme;
        match_type(p, "LPAREN");
        let params = [];
        if !check(p, "RPAREN") {
            push(params, advance(p).lexeme);
            while match_type(p, "COMMA") {
                push(params, advance(p).lexeme);
            }
        }
        match_type(p, "RPAREN");
        match_type(p, "LBRACE");
        let body = parse_block(p);
        return { "type": "Fn", "name": name, "params": params, "body": body };
    }

    if match_type(p, "RETURN") {
        let val = parse_expr(p);
        match_type(p, "SEMI");
        return { "type": "Return", "value": val };
    }

    // Re-assignment or Expression Statement
    if check(p, "IDENT") && p["tokens"][p["current"] + 1].ttype == "EQ" {
        let name = advance(p).lexeme;
        advance(p); // consume '='
        let val = parse_expr(p);
        match_type(p, "SEMI");
        return { "type": "Assign", "name": name, "value": val };
    }

    let expr = parse_expr(p);
    match_type(p, "SEMI");
    return { "type": "ExprStmt", "expr": expr };
}

fn parse_block(p) -> array {
    let stmts = [];
    while !check(p, "RBRACE") && !check(p, "EOF") {
        push(stmts, parse_statement(p));
    }
    match_type(p, "RBRACE");
    return stmts;
}

fn parse_program(p) -> array {
    let stmts = [];
    while !check(p, "EOF") {
        push(stmts, parse_statement(p));
    }
    return stmts;
}

// ----------------------------------------------------------------------------
// 3. EVALUATOR WITH SCOPE STACK & CONTROL FLOW
// ----------------------------------------------------------------------------
fn new_env() -> map {
    return { "scopes": [{}] };
}

fn push_scope(env) -> void {
    push(env["scopes"], {});
}

fn pop_scope(env) -> void {
    pop(env["scopes"]);
}

fn env_define(env, name, val) -> void {
    let scopes = env["scopes"];
    let top = scopes[len(scopes) - 1];
    top[name] = val;
}

fn env_get(env, name) -> map {
    let scopes = env["scopes"];
    let idx = len(scopes) - 1;
    while idx >= 0 {
        let scope = scopes[idx];
        if contains(scope, name) {
            return { "found": true, "val": scope[name] };
        }
        idx -= 1;
    }
    return { "found": false, "val": 0 };
}

fn env_assign(env, name, val) -> void {
    let scopes = env["scopes"];
    let idx = len(scopes) - 1;
    while idx >= 0 {
        let scope = scopes[idx];
        if contains(scope, name) {
            scope[name] = val;
            return;
        }
        idx -= 1;
    }
}

fn eval_expr(env, expr) -> map {
    let t = expr["type"];

    if t == "Number" || t == "String" || t == "Bool" { return expr["val"]; }

    if t == "Ident" {
        let res = env_get(env, expr["name"]);
        return res["found"] ? res["val"] : 0;
    }

    if t == "Binary" {
        let l = eval_expr(env, expr["left"]);
        let r = eval_expr(env, expr["right"]);
        let op = expr["op"];

        if op == "+" { return l + r; }
        if op == "-" { return l - r; }
        if op == "*" { return l * r; }
        if op == "/" { return l / r; }
        if op == "==" { return l == r; }
        if op == "!=" { return l != r; }
        if op == "<" { return l < r; }
        if op == ">" { return l > r; }
        if op == "<=" { return l <= r; }
        if op == ">=" { return l >= r; }
    }

    if t == "Call" {
        let func_res = env_get(env, expr["name"]);
        if func_res["found"] {
            let fn_obj = func_res["val"];
            let params = fn_obj["params"];
            let body = fn_obj["body"];
            let args = expr["args"];

            push_scope(env);
            let i = 0;
            while i < len(params) {
                let arg_val = eval_expr(env, args[i]);
                env_define(env, params[i], arg_val);
                i += 1;
            }

            let ret_val = eval_stmts(env, body);
            pop_scope(env);

            if type(ret_val) == "map" && contains(ret_val, "is_return") {
                return ret_val["val"];
            }
        }
    }

    return 0;
}

fn eval_stmts(env, stmts) -> map {
    let i = 0;
    while i < len(stmts) {
        let stmt = stmts[i];
        let t = stmt["type"];

        if t == "Let" {
            let val = eval_expr(env, stmt["value"]);
            env_define(env, stmt["name"], val);
        } else if t == "Assign" {
            let val = eval_expr(env, stmt["value"]);
            env_assign(env, stmt["name"], val);
        } else if t == "Print" {
            let val = eval_expr(env, stmt["value"]);
            print(val);
        } else if t == "Fn" {
            env_define(env, stmt["name"], { "params": stmt["params"], "body": stmt["body"] });
        } else if t == "Return" {
            let val = eval_expr(env, stmt["value"]);
            return { "is_return": true, "val": val };
        } else if t == "If" {
            if eval_expr(env, stmt["cond"]) {
                push_scope(env);
                let res = eval_stmts(env, stmt["then"]);
                pop_scope(env);
                if type(res) == "map" && contains(res, "is_return") { return res; }
            } else if len(stmt["else"]) > 0 {
                push_scope(env);
                let res = eval_stmts(env, stmt["else"]);
                pop_scope(env);
                if type(res) == "map" && contains(res, "is_return") { return res; }
            }
        } else if t == "While" {
            while eval_expr(env, stmt["cond"]) {
                push_scope(env);
                let res = eval_stmts(env, stmt["body"]);
                pop_scope(env);
                if type(res) == "map" && contains(res, "is_return") { return res; }
            }
        } else if t == "ExprStmt" {
            eval_expr(env, stmt["expr"]);
        }
        i += 1;
    }
    return 0;
}

// ----------------------------------------------------------------------------
// DRIVER TEST
// ----------------------------------------------------------------------------
fn main() -> void {
    clear_screen();
    print("==================================================================");
    print("  DONK ENGINE v2.0 - FULL SELF-HOSTED RECURSIVE INTERPRETER       ");
    print("==================================================================");

    let script = "
        fn fib(n) {
            if n <= 1 {
                return n;
            }
            return fib(n - 1) + fib(n - 2);
        }

        let i = 0;
        while i <= 7 {
            print(fib(i));
            i = i + 1;
        }
    ";

    print("[1] Source Code Executing Inside Self-Hosted Engine:");
    print(script);
    print("------------------------------------------------------------------");

    let tokens = lex_source(script);
    let parser = new_parser(tokens);
    let ast = parse_program(parser);
    let env = new_env();

    print("[2] Interpreter Output (Fibonacci Stream):");
    eval_stmts(env, ast);
    print("==================================================================");
}

main();