import "lexer.donk";
import "parser.donk";

if len(args) < 2 {
    print("Usage: donky compiler/compile.donk <input.donk> <output.json>");
} else {
    print("Compiling " + args[0] + "...");
    let src = read_file(args[0]);
    let tokens = tokenize(src);
    let ast = parse_program(tokens);
    let json_str = to_json(ast);
    write_file(args[1], json_str);
    print("Successfully compiled to " + args[1]);
}