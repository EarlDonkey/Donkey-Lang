import "lexer.donk";

// --- AST Helpers ---

fn make_node(type, props) -> map {
    let node = { "type": type };
    for k in keys(props) {
        node[k] = props[k];
    }
    return node;
}

// --- Parser State ---

fn new_state(token_list) -> map {
    return { "tokens": token_list, "pos": 0 };
}

fn p_peek(state) -> any {
    let t = state["tokens"];
    let p = state["pos"];
    if p >= len(t) {
        return t[len(t) - 1]; // EOF
    }
    return t[p];
}

fn p_advance(state) -> any {
    let tok = p_peek(state);
    if state["pos"] < len(state["tokens"]) {
        state["pos"] = state["pos"] + 1;
    }
    return tok;
}

fn p_check(state, type) -> bool {
    return p_peek(state).type == type;
}

fn p_match(state, type) -> bool {
    if p_check(state, type) {
        p_advance(state);
        return true;
    }
    return false;
}

fn p_expect(state, type) -> any {
    if p_check(state, type) {
        return p_advance(state);
    }
    let tok = p_peek(state);
    throw "Parse error at " + str(tok.line) + ":" + str(tok.col) + " expected " + type + " but got " + tok.type;
}

// --- Pratt Parser Precedence ---

fn get_infix_bp(type) -> num {
    if type == "OR" { return 1; }
    if type == "AND" { return 2; }
    if type == "EQEQ" || type == "NOTEQ" { return 3; }
    if type == "LT" || type == "LTEQ" || type == "GT" || type == "GTEQ" { return 4; }
    if type == "PLUS" || type == "MINUS" { return 6; }
    if type == "STAR" || type == "SLASH" || type == "PERCENT" || type == "DIV" { return 7; }
    return -1;
}

// --- Expressions ---

fn parse_expr(state, min_bp) -> map {
    let left = parse_prefix(state);

    while true {
        let op_tok = p_peek(state);
        let bp = get_infix_bp(op_tok.type);
        if bp == -1 || bp < min_bp {
            break;
        }
        p_advance(state);
        let right = parse_expr(state, bp + 1);
        
        left = make_node("Binary", {
            "left": left,
            "op": op_tok.lexeme,
            "right": right,
            "line": op_tok.line,
            "col": op_tok.col
        });
    }

    return left;
}

fn parse_prefix(state) -> map {
    let tok = p_advance(state);

    if tok.type == "NUMBER" {
        return make_node("Number", { "value": tok.literal, "line": tok.line, "col": tok.col });
    }
    if tok.type == "STRING" {
        return make_node("String", { "value": tok.literal, "line": tok.line, "col": tok.col });
    }
    if tok.type == "TRUE" {
        return make_node("Bool", { "value": true, "line": tok.line, "col": tok.col });
    }
    if tok.type == "FALSE" {
        return make_node("Bool", { "value": false, "line": tok.line, "col": tok.col });
    }
    if tok.type == "IDENT" {
        if p_check(state, "LPAREN") {
            p_advance(state);
            let args = [];
            if !p_check(state, "RPAREN") {
                push(args, parse_expr(state, 0));
                while p_match(state, "COMMA") {
                    push(args, parse_expr(state, 0));
                }
            }
            p_expect(state, "RPAREN");
            return make_node("Call", { "callee": tok.lexeme, "args": args, "line": tok.line, "col": tok.col });
        }
        return make_node("Ident", { "name": tok.lexeme, "line": tok.line, "col": tok.col });
    }
    if tok.type == "MINUS" {
        let operand = parse_expr(state, 8);
        return make_node("Unary", { "op": "-", "operand": operand, "line": tok.line, "col": tok.col });
    }
    if tok.type == "BANG" {
        let operand = parse_expr(state, 8);
        return make_node("Unary", { "op": "!", "operand": operand, "line": tok.line, "col": tok.col });
    }
    if tok.type == "LPAREN" {
        let expr = parse_expr(state, 0);
        p_expect(state, "RPAREN");
        return expr;
    }
    if tok.type == "LBRACKET" {
        let elems = [];
        if !p_check(state, "RBRACKET") {
            push(elems, parse_expr(state, 0));
            while p_match(state, "COMMA") {
                push(elems, parse_expr(state, 0));
            }
        }
        p_expect(state, "RBRACKET");
        return make_node("ArrayLit", { "elems": elems, "line": tok.line, "col": tok.col });
    }

    throw "Unexpected token in expression: " + tok.type + " at " + str(tok.line) + ":" + str(tok.col);
}

// --- Statements ---

fn parse_let(state) -> map {
    let tok = p_advance(state);
    let name = p_expect(state, "IDENT");
    p_expect(state, "EQ");
    let value = parse_expr(state, 0);
    p_expect(state, "SEMI");
    return make_node("LetStmt", { "name": name.lexeme, "value": value, "line": tok.line, "col": tok.col });
}

fn parse_print(state) -> map {
    let tok = p_advance(state);
    p_expect(state, "LPAREN");
    let value = parse_expr(state, 0);
    p_expect(state, "RPAREN");
    p_expect(state, "SEMI");
    return make_node("PrintStmt", { "value": value, "line": tok.line, "col": tok.col });
}

fn parse_if(state) -> map {
    let tok = p_advance(state);
    let cond = parse_expr(state, 0);
    let then_block = parse_block(state);
    let else_block = "";
    if p_match(state, "ELSE") {
        else_block = parse_block(state);
    }
    return make_node("IfStmt", {
        "cond": cond, "then": then_block, "else": else_block, "line": tok.line, "col": tok.col
    });
}

fn parse_while(state) -> map {
    let tok = p_advance(state);
    let cond = parse_expr(state, 0);
    let body = parse_block(state);
    return make_node("WhileStmt", { "cond": cond, "body": body, "line": tok.line, "col": tok.col });
}

fn parse_return(state) -> map {
    let tok = p_advance(state);
    if p_match(state, "SEMI") {
        return make_node("ReturnStmt", { "value": "", "line": tok.line, "col": tok.col });
    }
    let value = parse_expr(state, 0);
    p_expect(state, "SEMI");
    return make_node("ReturnStmt", { "value": value, "line": tok.line, "col": tok.col });
}

fn parse_block(state) -> map {
    let tok = p_expect(state, "LBRACE");
    let stmts = [];
    while !p_check(state, "RBRACE") && !p_check(state, "EOF") {
        push(stmts, parse_statement(state));
    }
    p_expect(state, "RBRACE");
    return make_node("Block", { "stmts": stmts, "line": tok.line, "col": tok.col });
}

fn parse_expr_stmt(state) -> map {
    let tok = p_peek(state);
    let next_tok = state["tokens"][state["pos"] + 1];
    if tok.type == "IDENT" && next_tok.type == "EQ" {
        let name = p_advance(state).lexeme;
        p_advance(state); // =
        let value = parse_expr(state, 0);
        p_expect(state, "SEMI");
        return make_node("AssignStmt", { "name": name, "value": value, "line": tok.line, "col": tok.col });
    }

    let expr = parse_expr(state, 0);
    p_expect(state, "SEMI");
    return make_node("ExprStmt", { "expr": expr, "line": tok.line, "col": tok.col });
}

fn parse_statement(state) -> map {
    if p_check(state, "LET")    { return parse_let(state); }
    if p_check(state, "PRINT")  { return parse_print(state); }
    if p_check(state, "IF")     { return parse_if(state); }
    if p_check(state, "WHILE")  { return parse_while(state); }
    if p_check(state, "RETURN") { return parse_return(state); }
    if p_check(state, "LBRACE") { return parse_block(state); }
    return parse_expr_stmt(state);
}

fn parse_program(token_list) -> map {
    let state = new_state(token_list);
    let stmts = [];
    while !p_check(state, "EOF") {
        push(stmts, parse_statement(state));
    }
    return make_node("Program", { "stmts": stmts });
}