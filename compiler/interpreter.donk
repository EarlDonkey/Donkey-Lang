import "../lib/strings.donk";

// --- Environments ---

fn new_env(parent) -> map {
    return { "vars": {}, "parent": parent };
}

fn env_get(env, name) -> any {
    let vars = env["vars"];
    if contains(vars, name) {
        return vars[name];
    }
    if env["parent"] != "" {
        return env_get(env["parent"], name);
    }
    throw "Undefined variable: " + name;
}

fn env_set(env, name, value) -> void {
    let vars = env["vars"];
    if contains(vars, name) {
        vars[name] = value;
        return;
    }
    if env["parent"] != "" {
        env_set(env["parent"], name, value);
        return;
    }
    throw "Assignment to undefined variable: " + name;
}

fn env_define(env, name, value) -> void {
    let vars = env["vars"];
    vars[name] = value;
}

// --- Expressions ---

fn eval_expr(node, env) -> any {
    let t = node["type"];
    
    if t == "Number" { return node["value"]; }
    if t == "String" { return node["value"]; }
    if t == "Bool"   { return node["value"]; }
    if t == "Ident"  { return env_get(env, node["name"]); }
    
    if t == "Binary" {
        let left = eval_expr(node["left"], env);
        let right = eval_expr(node["right"], env);
        let op = node["op"];
        
        if op == "+" {
            if type(left) == "string" || type(right) == "string" {
                return str(left) + str(right);
            }
            return left + right;
        }
        if op == "-" { return left - right; }
        if op == "*" { return left * right; }
        if op == "/" { return left / right; }
        if op == "%" { return left % right; }
        if op == "==" { return left == right; }
        if op == "!=" { return left != right; }
        if op == "<"  { return left < right; }
        if op == "<=" { return left <= right; }
        if op == ">"  { return left > right; }
        if op == ">=" { return left >= right; }
        if op == "&&" { return left && right; }
        if op == "||" { return left || right; }
    }
    
    if t == "Unary" {
        let val = eval_expr(node["operand"], env);
        if node["op"] == "-" { return -val; }
        if node["op"] == "!" { return !val; }
    }
    
    if t == "Call" {
        let callee = node["callee"];
        let args = [];
        for arg in node["args"] {
            push(args, eval_expr(arg, env));
        }
        
        // Builtins
        if callee == "print" {
            let out = "";
            for a in args { out = out + str(a) + " "; }
            print(out);
            return "";
        }
        if callee == "len"  { return len(args[0]); }
        if callee == "str"  { return str(args[0]); }
        if callee == "num"  { return num(args[0]); }
        if callee == "type" { return type(args[0]); }
        
        // User function
        let callee_fn = env_get(env, callee);
        if callee_fn == "" { throw "Not a function: " + callee; }
        
        let call_env = new_env(callee_fn["closure"]);
        let i = 0;
        while i < len(args) {
            env_define(call_env, callee_fn["params"][i], args[i]);
            i = i + 1;
        }
        
        try {
            for s in callee_fn["body"] {
                exec_stmt(s, call_env);
            }
        } catch e {
            if starts_with(e, "RETURN:") {
                let val_str = slice(e, 7, len(e));
                // If it's a number, return the number. Otherwise, return the string.
                let n = num(val_str);
                if str(n) == val_str { return n; }
                return val_str;
            }
            throw e;
        }
        return "";
    }
    
    throw "Cannot evaluate expression: " + t;
}

// --- Statements ---

fn exec_stmt(node, env) -> void {
    let t = node["type"];
    
    if t == "Program" {
        for s in node["stmts"] {
            exec_stmt(s, env);
        }
        return;
    }
    
    if t == "LetStmt" {
        let val = eval_expr(node["value"], env);
        env_define(env, node["name"], val);
        return;
    }
    
    if t == "AssignStmt" {
        let val = eval_expr(node["value"], env);
        env_set(env, node["name"], val);
        return;
    }
    
    if t == "PrintStmt" {
        let val = eval_expr(node["value"], env);
        print(val);
        return;
    }
    
    if t == "ExprStmt" {
        eval_expr(node["expr"], env);
        return;
    }
    
    if t == "Block" {
        let block_env = new_env(env);
        for s in node["stmts"] {
            exec_stmt(s, block_env);
        }
        return;
    }
    
    if t == "IfStmt" {
        let cond = eval_expr(node["cond"], env);
        if cond {
            exec_stmt(node["then"], env);
        } else if node["else"] != "" {
            exec_stmt(node["else"], env);
        }
        return;
    }
    
    if t == "WhileStmt" {
        while eval_expr(node["cond"], env) {
            exec_stmt(node["body"], env);
        }
        return;
    }
    
    throw "Cannot execute statement: " + t;
}