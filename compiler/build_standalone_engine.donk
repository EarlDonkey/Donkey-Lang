// ============================================================================
// STANDALONE META-COMPILER DRIVER (build_standalone_engine.donk)
// Compiles the self-hosted donk_engine_v2.donk into raw x86-64 NASM assembly
// ============================================================================

import "codegen_kernel.donk";

fn main() -> void {
    print("[1/3] Loading donk_engine_v2.donk source...");
    let engine_source = read_file("donk_engine_v2.donk");
    
    print("[2/3] Generating x86-64 NASM Assembly via codegen_kernel...");
    // Parser AST is passed from donky-native runner
    let asm_output = compile_to_kernel(engine_source);
    
    print("[3/3] Emitting standalone_engine.asm...");
    write_file("standalone_engine.asm", asm_output);
    
    print("[+] Meta-compilation complete! File saved as standalone_engine.asm");
}

main();