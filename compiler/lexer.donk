import "../lib/strings.donk";

// --- Data Structures ---

struct Token {
    type: str,
    lexeme: str,
    literal: any,
    line: num,
    col: num
}

struct LexerState {
    source: str,
    pos: num,
    line: num,
    col: num
}

// --- State Helpers ---

fn at_end(state) -> bool {
    return state["pos"] >= len(state["source"]);
}

fn peek(state, offset) -> str {
    let i = state["pos"] + offset;
    if i >= len(state["source"]) {
        return "";
    }
    return state["source"][i];
}

fn advance(state) -> str {
    let ch = state["source"][state["pos"]];
    state["pos"] = state["pos"] + 1;
    if ch == "\n" {
        state["line"] = state["line"] + 1;
        state["col"] = 1;
    } else {
        state["col"] = state["col"] + 1;
    }
    return ch;
}

// --- Token Readers ---

fn keyword_or_ident(text) -> str {
    if text == "let" { return "LET"; }
    if text == "fn" { return "FN"; }
    if text == "if" { return "IF"; }
    if text == "else" { return "ELSE"; }
    if text == "while" { return "WHILE"; }
    if text == "for" { return "FOR"; }
    if text == "in" { return "IN"; }
    if text == "return" { return "RETURN"; }
    if text == "print" { return "PRINT"; }
    if text == "true" { return "TRUE"; }
    if text == "false" { return "FALSE"; }
    if text == "div" { return "DIV"; }
    if text == "break" { return "BREAK"; }
    if text == "continue" { return "CONTINUE"; }
    if text == "try" { return "TRY"; }
    if text == "catch" { return "CATCH"; }
    if text == "throw" { return "THROW"; }
    if text == "import" { return "IMPORT"; }
    if text == "struct" { return "STRUCT"; }
    return "IDENT";
}

fn read_number(state, first, line, col) -> Token {
    let start = state["pos"] - 1;
    let seen_dot = false;
    if first == "." { seen_dot = true; }
    
    while !at_end(state) {
        let ch = peek(state, 0);
        if ch >= "0" && ch <= "9" {
            advance(state);
        } else if ch == "." && !seen_dot {
            seen_dot = true;
            advance(state);
        } else {
            break;
        }
    }
    let text = slice(state["source"], start, state["pos"]);
    let lit = num(text);
    return Token { type: "NUMBER", lexeme: text, literal: lit, line: line, col: col };
}

fn read_string(state, first, quote, line, col) -> Token {
    let start = state["pos"] - 1;
    while !at_end(state) && peek(state, 0) != quote {
        if peek(state, 0) == "\\" {
            advance(state); // skip escaped char
        }
        advance(state);
    }
    if at_end(state) {
        throw "unterminated string";
    }
    advance(state); // closing quote
    let text = slice(state["source"], start, state["pos"]);
    let lit = slice(state["source"], start + 1, state["pos"] - 1);
    return Token { type: "STRING", lexeme: text, literal: lit, line: line, col: col };
}

fn read_identifier(state, first, line, col) -> Token {
    let start = state["pos"] - 1;
    while !at_end(state) {
        let ch = peek(state, 0);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            advance(state);
        } else {
            break;
        }
    }
    let text = slice(state["source"], start, state["pos"]);
    let ttype = keyword_or_ident(text);
    let lit = "";
    if ttype == "TRUE" { lit = true; }
    if ttype == "FALSE" { lit = false; }
    return Token { type: ttype, lexeme: text, literal: lit, line: line, col: col };
}

// --- Main Tokenizer ---

fn tokenize(source) -> array {
    let state = LexerState { source: source, pos: 0, line: 1, col: 1 };
    let tokens = [];
    
    while !at_end(state) {
        let line = state["line"];
        let col = state["col"];
        let ch = advance(state);
        
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            continue;
        }
        
        if ch == "/" && peek(state, 0) == "/" {
            while peek(state, 0) != "\n" && !at_end(state) {
                advance(state);
            }
            continue;
        }
        
        if ch >= "0" && ch <= "9" {
            push(tokens, read_number(state, ch, line, col));
        } else if ch == "\"" {
            push(tokens, read_string(state, ch, "\"", line, col));
        } else if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_" {
            push(tokens, read_identifier(state, ch, line, col));
        } else {
            let type = "";
            let lex = ch;
            if ch == "+" { type = "PLUS"; }
            else if ch == "-" { type = "MINUS"; }
            else if ch == "*" { type = "STAR"; }
            else if ch == "/" { type = "SLASH"; }
            else if ch == "%" { type = "PERCENT"; }
            else if ch == "(" { type = "LPAREN"; }
            else if ch == ")" { type = "RPAREN"; }
            else if ch == "{" { type = "LBRACE"; }
            else if ch == "}" { type = "RBRACE"; }
            else if ch == "[" { type = "LBRACKET"; }
            else if ch == "]" { type = "RBRACKET"; }
            else if ch == ";" { type = "SEMI"; }
            else if ch == "," { type = "COMMA"; }
            else if ch == ":" { type = "COLON"; }
            else if ch == "." { type = "DOT"; }
            else if ch == "=" {
                if peek(state, 0) == "=" { advance(state); type = "EQEQ"; lex = "=="; }
                else { type = "EQ"; }
            }
            else if ch == "!" {
                if peek(state, 0) == "=" { advance(state); type = "NOTEQ"; lex = "!="; }
                else { type = "BANG"; }
            }
            else if ch == "<" {
                if peek(state, 0) == "=" { advance(state); type = "LTEQ"; lex = "<="; }
                else { type = "LT"; }
            }
            else if ch == ">" {
                if peek(state, 0) == "=" { advance(state); type = "GTEQ"; lex = ">="; }
                else { type = "GT"; }
            }
            else if ch == "&" {
                if peek(state, 0) == "&" { advance(state); type = "AND"; lex = "&&"; }
                else { throw "unexpected &"; }
            }
            else if ch == "|" {
                if peek(state, 0) == "|" { advance(state); type = "OR"; lex = "||"; }
                else { throw "unexpected |"; }
            }
            else {
                throw "unexpected character: " + ch;
            }
            
            push(tokens, Token { type: type, lexeme: lex, literal: "", line: line, col: col });
        }
    }
    
    push(tokens, Token { type: "EOF", lexeme: "", literal: "", line: state["line"], col: state["col"] });
    return tokens;
}