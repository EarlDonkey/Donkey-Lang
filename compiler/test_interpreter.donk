import "lexer.donk";
import "parser.donk";
import "interpreter.donk";

let source = "
let x = 10;
let y = 20;
let z = x + y;
print(z);

let i = 0;
while i < 3 {
    print(\"Count: \" + str(i));
    i = i + 1;
}

if z > 25 {
    print(\"z is big!\");
} else {
    print(\"z is small.\");
}
";

print("--- Tokenizing ---");
let tokens = tokenize(source);
print("Got " + str(len(tokens)) + " tokens.");

print("\n--- Parsing ---");
let ast = parse_program(tokens);

print("\n--- Interpreting ---");
let global_env = new_env("");
exec_stmt(ast, global_env);