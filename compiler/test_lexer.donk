import "lexer.donk";

let source = "let x = 10;\nlet y = \"hello\";\nif x > 5 {\n    print(y);\n}\n";

print("Tokenizing source...");
let tokens = tokenize(source);

for tok in tokens {
    let lit_str = "None";
    if tok.literal != "" {
        lit_str = str(tok.literal);
    }
    print("[" + str(tok.line) + ":" + str(tok.col) + "] " + tok.type + "  " + tok.lexeme + "  " + lit_str);
}