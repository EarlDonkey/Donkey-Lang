// lib/datetime.donk — timestamps and formatting from unix seconds

import "lib/math.donk";
import "lib/string.donk";

// --- core conversions ---

fn _pad(n, width) -> string {
    return int_to_padded(n, width);
}

// Convert days-since-1970-01-01 into [year, month, day].
// Algorithm: Howard Hinnant's civil_from_days.
fn _civil_from_days(days) -> array {
    let z = days + 719468;
    let era = floor(z / 146097);
    let doe = z - era * 146097;
    let yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365);
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100));
    let mp = floor((5 * doy + 2) / 153);
    let d = doy - floor((153 * mp + 2) / 5) + 1;
    let m = 0;
    if mp < 10 { m = mp + 3; } else { m = mp - 9; }
    if m <= 2 { y = y + 1; }
    return [y, m, d];
}

// Decompose a unix-second timestamp into [year, month, day, hour, minute, second].
fn decompose(secs) -> array {
    let days = floor(secs / 86400);
    let secs_day = secs - days * 86400;
    let h = floor(secs_day / 3600);
    let mi = floor((secs_day - h * 3600) / 60);
    let se = secs_day - h * 3600 - mi * 60;
    let ymd = _civil_from_days(days);
    return [ymd[0], ymd[1], ymd[2], h, mi, se];
}

// --- public API ---

fn now_iso() -> string {
    return to_iso(now());
}

fn to_iso(secs) -> string {
    let d = decompose(secs);
    return _pad(d[0], 4) + "-" + _pad(d[1], 2) + "-" + _pad(d[2], 2) + "T"
         + _pad(d[3], 2) + ":" + _pad(d[4], 2) + ":" + _pad(d[5], 2) + "Z";
}

fn to_date(secs) -> string {
    let d = decompose(secs);
    return _pad(d[0], 4) + "-" + _pad(d[1], 2) + "-" + _pad(d[2], 2);
}

fn to_time(secs) -> string {
    let d = decompose(secs);
    return _pad(d[3], 2) + ":" + _pad(d[4], 2) + ":" + _pad(d[5], 2);
}

fn year_of(secs) -> number { return decompose(secs)[0]; }
fn month_of(secs) -> number { return decompose(secs)[1]; }
fn day_of(secs) -> number { return decompose(secs)[2]; }
fn hour_of(secs) -> number { return decompose(secs)[3]; }
fn minute_of(secs) -> number { return decompose(secs)[4]; }
fn second_of(secs) -> number { return decompose(secs)[5]; }

// Composable constructors: unix seconds = base + offset
fn add_days(secs, n) -> number { return secs + n * 86400; }
fn add_hours(secs, n) -> number { return secs + n * 3600; }
fn add_minutes(secs, n) -> number { return secs + n * 60; }
fn add_seconds(secs, n) -> number { return secs + n; }

// Human-friendly elapsed time. e.g. 3725 seconds -> "1h 2m 5s"
fn elapsed_str(secs) -> string {
    let s = floor(secs);
    if s < 60 { return str(s) + "s"; }
    let parts = [];
    let remaining = s;
    let days = floor(remaining / 86400);
    remaining = remaining - days * 86400;
    let hours = floor(remaining / 3600);
    remaining = remaining - hours * 3600;
    let mins = floor(remaining / 60);
    remaining = remaining - mins * 60;
    if days > 0 { push(parts, str(days) + "d"); }
    if hours > 0 { push(parts, str(hours) + "h"); }
    if mins > 0 { push(parts, str(mins) + "m"); }
    if remaining > 0 || len(parts) == 0 { push(parts, str(remaining) + "s"); }
    return join(parts, " ");
}