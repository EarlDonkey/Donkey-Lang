// lib/list.donk — higher-order helpers for arrays.
// Import with: import "lib/list.donk";
//
// Parameters that receive a function are named `f` because `fn` is a
// reserved keyword in Donky.

fn map(arr, f) -> array {
    let out = [];
    for x in arr {
        push(out, f(x));
    }
    return out;
}

fn filter(arr, f) -> array {
    let out = [];
    for x in arr {
        if f(x) {
            push(out, x);
        }
    }
    return out;
}

fn reduce(arr, f, init) -> any {
    let acc = init;
    for x in arr {
        acc = f(acc, x);
    }
    return acc;
}

fn reverse(arr) -> array {
    let out = [];
    let i = len(arr) - 1;
    while i >= 0 {
        push(out, arr[i]);
        i = i - 1;
    }
    return out;
}

fn unique(arr) -> array {
    let out = [];
    for x in arr {
        if !contains(out, x) {
            push(out, x);
        }
    }
    return out;
}

fn any(arr, f) -> bool {
    for x in arr {
        if f(x) {
            return true;
        }
    }
    return false;
}

fn all(arr, f) -> bool {
    for x in arr {
        if !f(x) {
            return false;
        }
    }
    return true;
}

fn count(arr, f) -> num {
    let n = 0;
    for x in arr {
        if f(x) {
            n = n + 1;
        }
    }
    return n;
}