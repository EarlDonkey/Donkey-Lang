// lib/json.donk — parse and stringify JSON

// Parser state is a 2-element array: [source_string, current_index]
// This lets us mutate position from helper functions.

fn json_peek(st) -> number {
    let s = st[0];
    let i = st[1];
    if i >= len(s) { return -1; }
    return byte_at(s, i);
}

fn json_advance(st) {
    st[1] = st[1] + 1;
}

fn json_skip_ws(st) {
    while true {
        let c = json_peek(st);
        if c == 32 || c == 9 || c == 10 || c == 13 {
            json_advance(st);
        } else {
            return;
        }
    }
}

fn json_parse_string(st) -> string {
    json_advance(st);   // skip opening "
    let out = "";
    while true {
        let c = json_peek(st);
        if c == 34 {    // closing "
            json_advance(st);
            return out;
        }
        if c == -1 { throw "json: unterminated string"; }
        if c == 92 {    // backslash
            json_advance(st);
            let e = json_peek(st);
            if e == 110 { out = out + "\n"; }       // n
            else if e == 116 { out = out + "\t"; }  // t
            else if e == 114 { out = out + "\r"; }  // r
            else if e == 34 { out = out + "\""; }   // "
            else if e == 92 { out = out + "\\"; }   // \
            else if e == 47 { out = out + "/"; }    // /
            else { throw "json: bad escape \\" + bytes_to_str([e]); }
            json_advance(st);
        } else {
            out = out + bytes_to_str([c]);
            json_advance(st);
        }
    }
}

fn json_parse_number(st) -> number {
    let start = st[1];
    while true {
        let c = json_peek(st);
        if (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 101 || c == 69 || c == 43 {
            json_advance(st);
        } else {
            return num(byte_substr(st[0], start, st[1]));
        }
    }
}

fn json_parse_object(st) {
    json_advance(st);   // skip {
    let m = {};
    json_skip_ws(st);
    if json_peek(st) == 125 {   // }
        json_advance(st);
        return m;
    }
    while true {
        json_skip_ws(st);
        let k = json_parse_string(st);
        json_skip_ws(st);
        if json_peek(st) != 58 { throw "json: expected ':'"; }
        json_advance(st);
        let v = json_parse_value(st);
        m[k] = v;
        json_skip_ws(st);
        let c = json_peek(st);
        if c == 44 { json_advance(st); continue; }   // ,
        if c == 125 { json_advance(st); return m; }  // }
        throw "json: expected ',' or '}'";
    }
}

fn json_parse_array(st) {
    json_advance(st);   // skip [
    let a = [];
    json_skip_ws(st);
    if json_peek(st) == 93 {    // ]
        json_advance(st);
        return a;
    }
    while true {
        let v = json_parse_value(st);
        push(a, v);
        json_skip_ws(st);
        let c = json_peek(st);
        if c == 44 { json_advance(st); continue; }   // ,
        if c == 93 { json_advance(st); return a; }   // ]
        throw "json: expected ',' or ']'";
    }
}

fn json_parse_value(st) {
    json_skip_ws(st);
    let c = json_peek(st);
    if c == -1 { throw "json: unexpected end of input"; }
    if c == 34 { return json_parse_string(st); }    // "
    if c == 123 { return json_parse_object(st); }   // {
    if c == 91  { return json_parse_array(st); }    // [
    if c == 116 { st[1] = st[1] + 4; return true; } // true
    if c == 102 { st[1] = st[1] + 5; return false; } // false
    if c == 110 { st[1] = st[1] + 4; return null; } // null
    return json_parse_number(st);
}

fn json_parse(s) {
    let st = [s, 0];
    let v = json_parse_value(st);
    json_skip_ws(st);
    if st[1] < len(s) { throw "json: trailing garbage at " + str(st[1]); }
    return v;
}

fn json_escape(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let c = byte_at(s, i);
        if c == 34 { out = out + "\\\""; }
        else if c == 92 { out = out + "\\\\"; }
        else if c == 10 { out = out + "\\n"; }
        else if c == 9  { out = out + "\\t"; }
        else if c == 13 { out = out + "\\r"; }
        else { out = out + bytes_to_str([c]); }
        i = i + 1;
    }
    return out;
}

fn json_stringify(v) -> string {
    let t = type(v);
    if t == "null" { return "null"; }
    if t == "bool" {
        if v { return "true"; }
        return "false";
    }
    if t == "number" { return str(v); }
    if t == "string" { return "\"" + json_escape(v) + "\""; }
    if t == "array" {
        let parts = [];
        let i = 0;
        while i < len(v) {
            push(parts, json_stringify(v[i]));
            i = i + 1;
        }
        return "[" + join(parts, ",") + "]";
    }
    if t == "map" {
        let parts = [];
        for k in keys(v) {
            push(parts, "\"" + json_escape(k) + "\":" + json_stringify(v[k]));
        }
        return "{" + join(parts, ",") + "}";
    }
    throw "json: cannot stringify " + t;
}