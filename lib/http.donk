// lib/http.donk — thin HTTP helpers built on http_get

fn http_get_text(url) {
    return http_get(url);
}

fn http_get_json(url) {
    import "lib/json.donk";
    return json_parse(http_get(url));
}

// Build a query string from a map
fn url_encode(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let c = byte_at(s, i);
        // keep alnum and a few safe chars
        let is_alnum = (c >= 48 && c <= 57)
                    || (c >= 65 && c <= 90)
                    || (c >= 97 && c <= 122)
                    || c == 45 || c == 46 || c == 95 || c == 126;
        if is_alnum {
            out = out + bytes_to_str([c]);
        } else {
            out = out + "%" + byte_substr("0123456789ABCDEF", (c / 16) - ((c / 16) % 1), ((c / 16) - ((c / 16) % 1)) + 1);
            out = out + byte_substr("0123456789ABCDEF", (c % 16) - 0, ((c % 16) - 0) + 1);
        }
        i = i + 1;
    }
    return out;
}

fn build_query(params) {
    let parts = [];
    for k in keys(params) {
        push(parts, url_encode(k) + "=" + url_encode(str(params[k])));
    }
    return join(parts, "&");
}

fn http_get_with_query(base, params) {
    return http_get(base + "?" + build_query(params));
}

fn read_until(client, delim, max_bytes) {
    let buf = "";
    while len(buf) < max_bytes {
        let chunk = tcp_read(client, 4096);
        if len(chunk) == 0 { break; }
        buf = buf + chunk;
        if contains(buf, delim) { break; }
    }
    return buf;
}

fn get_path(raw_req) {
    // raw_req looks like "GET /index.html HTTP/1.1\r\nHost: localhost..."
    let lines = split(raw_req, "\r\n");
    if len(lines) == 0 { return "/index.html"; }
    
    let parts = split(lines[0], " ");
    if len(parts) < 2 { return "/index.html"; }
    
    let path = parts[1];
    if path == "/" { return "/index.html"; }
    
    // Security: prevent directory traversal (e.g., ../../windows/system32)
    if contains(path, "..") { return "/404.html"; }
    
    return path;
}

fn mime_for(path) {
    if ends_with(path, ".css") { return "text/css"; }
    if ends_with(path, ".js")  { return "text/javascript"; }
    if ends_with(path, ".png") { return "image/png"; }
    if ends_with(path, ".jpg") { return "image/jpeg"; }
    if ends_with(path, ".jpeg"){ return "image/jpeg"; }
    if ends_with(path, ".svg") { return "image/svg+xml"; }
    if ends_with(path, ".ico") { return "image/x-icon"; }
    return "text/html"; // default
}