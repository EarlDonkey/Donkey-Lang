// lib/array.donk — array helpers

fn map(arr, f) {
    let out = [];
    for x in arr {
        push(out, f(x));
    }
    return out;
}

fn filter(arr, pred) {
    let out = [];
    for x in arr {
        if pred(x) { push(out, x); }
    }
    return out;
}

fn reduce(arr, f, init) {
    let acc = init;
    for x in arr {
        acc = f(acc, x);
    }
    return acc;
}

fn range(start, end) {
    let out = [];
    let i = start;
    while i < end {
        push(out, i);
        i = i + 1;
    }
    return out;
}

fn contains_val(arr, x) {
    for v in arr {
        if v == x { return true; }
    }
    return false;
}

fn index_of_val(arr, x) {
    let i = 0;
    while i < len(arr) {
        if arr[i] == x { return i; }
        i = i + 1;
    }
    return -1;
}

fn reverse_arr(arr) {
    let out = [];
    let i = len(arr) - 1;
    while i >= 0 {
        push(out, arr[i]);
        i = i - 1;
    }
    return out;
}

fn sort(arr) {
    let out = [];
    for x in arr { push(out, x); }
    let n = len(out);
    let i = 0;
    while i < n {
        let j = 0;
        while j < n - i - 1 {
            if out[j] > out[j + 1] {
                let t = out[j];
                out[j] = out[j + 1];
                out[j + 1] = t;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn sum(arr) {
    let total = 0;
    for x in arr { total = total + x; }
    return total;
}

fn zip(a, b) {
    let out = [];
    let n = min(len(a), len(b));
    let i = 0;
    while i < n {
        push(out, [a[i], b[i]]);
        i = i + 1;
    }
    return out;
}

fn flatten(arr) {
    let out = [];
    for x in arr {
        if type(x) == "array" {
            for y in x { push(out, y); }
        } else {
            push(out, x);
        }
    }
    return out;
}

fn unique(arr) {
    let out = [];
    for x in arr {
        let found = false;
        for y in out {
            if x == y { found = true; }
        }
        if !found { push(out, x); }
    }
    return out;
}