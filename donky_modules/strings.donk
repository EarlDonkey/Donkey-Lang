// lib/strings.donk — string helpers built on top of Donky's native strings.
// Import with: import "lib/strings.donk";

// True if s starts with prefix. starts_with("hello", "he") -> true
fn starts_with(s, prefix) -> bool {
    if len(prefix) > len(s) {
        return false;
    }
    let i = 0;
    while i < len(prefix) {
        if s[i] != prefix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// True if s ends with suffix. ends_with("hello", "lo") -> true
fn ends_with(s, suffix) -> bool {
    if len(suffix) > len(s) {
        return false;
    }
    let offset = len(s) - len(suffix);
    let i = 0;
    while i < len(suffix) {
        if s[offset + i] != suffix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Return the substring of s from index start (inclusive) to end (exclusive).
// slice("hello", 1, 4) -> "ell". If end > len(s), clamps to len(s).
fn slice(s, start, end) -> str {
    if start < 0 { start = 0; }
    if end > len(s) { end = len(s); }
    let out = "";
    let i = start;
    while i < end {
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

// Return the index of the first occurrence of needle in haystack,
// or -1 if not found. index_of("hello", "ll") -> 2
fn index_of(haystack, needle) -> num {
    if len(needle) == 0 {
        return 0;
    }
    if len(needle) > len(haystack) {
        return -1;
    }
    let limit = len(haystack) - len(needle);
    let i = 0;
    while i <= limit {
        if slice(haystack, i, i + len(needle)) == needle {
            return i;
        }
        i = i + 1;
    }
    return -1;
}