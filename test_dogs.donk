// No more new_dog factory function needed!
fn main() {
    let dogs = [];
    
    // Real struct syntax!
    push(dogs, Dog { name: "Buddy", age: 3, breed: "Corgi" });
    push(dogs, Dog { name: "Max", age: 5, breed: "Terrier" });
    push(dogs, Dog { name: "Bella", age: 2, breed: "Shiba Inu" });
    
    // Iterate over the array of objects
    for dog in dogs {
        print(dog["name"] + " (" + dog["breed"] + ", Age " + str(dog["age"]) + ")");
    }
    
    // Access a specific field
    print("First dog's name is: " + dogs[0]["name"]);
    print("First dog's type is: " + dogs[0]["__type__"]);
}

main();