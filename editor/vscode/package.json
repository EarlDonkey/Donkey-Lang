{
  "name": "donky",
  "displayName": "Donky",
  "description": "Syntax highlighting and language support for Donky",
  "version": "0.1.0",
  "publisher": "Earl Donkey",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "donky",
        "aliases": ["Donky", "donky"],
        "extensions": [".donk"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "donky",
        "scopeName": "source.donky",
        "path": "./syntaxes/donky.tmLanguage.json"
      }
    ]
  },
  "license": "MIT"
}