{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Donky",
  "scopeName": "source.donky",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#fn-declaration" },
    { "include": "#let-declaration" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.donky",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.donky",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.donky",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.donky",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.donky",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.donky",
          "match": "\\b(if|else|while|for|in|return|break|continue|try|catch|throw)\\b"
        },
        {
          "name": "keyword.other.donky",
          "match": "\\b(let|fn|import|print|div)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.donky",
          "match": "\\b(len|str|num|type|push|pop|read_file|write_file|file_exists|split|join|contains|keys|upper|lower|trim|replace|input|sort)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.donky",
          "match": "==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>=!]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.donky",
          "match": "[(){}\\[\\];,:]"
        }
      ]
    },
    "fn-declaration": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.donky" },
            "2": { "name": "entity.name.function.donky" }
          }
        }
      ]
    },
    "let-declaration": {
      "patterns": [
        {
          "match": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.donky" },
            "2": { "name": "variable.other.donky" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.donky",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}