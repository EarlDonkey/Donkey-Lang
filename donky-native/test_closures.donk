print("=== Closure Tests ===");

fn make_counter() {
    let count = 0;
    return fn() {
        count = count + 1;
        return count;
    };
}

let c1 = make_counter();
let c2 = make_counter();
print("c1: " + str(c1()));  // 1
print("c1: " + str(c1()));  // 2
print("c1: " + str(c1()));  // 3
print("c2: " + str(c2()));  // 1

fn make_adder(n) {
    return fn(x) { return x + n; };
}
let add5 = make_adder(5);
let add10 = make_adder(10);
print("add5(3): " + str(add5(3)));    // 8
print("add10(3): " + str(add10(3)));  // 13

fn make_outer(a) {
    return fn(b) {
        return fn(c) { return a + b + c; };
    };
}
let fn1 = make_outer(1);
let fn2 = fn1(2);
let inner = fn2(3);
print("1+2+3 = " + str(inner));       // 6