// lexer.donk — Self-Hosted Donky Lexer

struct Token {
    type: string,
    lexeme: string,
    literal: string,
    line: number,
    col: number
}

fn make_token(type, lexeme, literal, line, col) -> map {
    return {
        "type": type,
        "lexeme": lexeme,
        "literal": literal,
        "line": line,
        "col": col
    };
}

fn tokenize(source) -> array {
    let tokens = [];
    let i = 0;
    let line = 1;
    let col = 1;
    let len = len(source);

    // Skip UTF-8 BOM (EF BB BF) if present — Windows editors often write one
    if len >= 3 && byte_at(source, 0) == 239 && byte_at(source, 1) == 187 && byte_at(source, 2) == 191 {
        i = 3;
        col = 4;
    }

    while i < len {
        let c = byte_at(source, i);
        
        if c == 32 || c == 9 || c == 13 { 
            i = i + 1; col = col + 1;
        } else if c == 10 { 
            i = i + 1; line = line + 1; col = 1;
        } 
        else if c == 47 && i + 1 < len && byte_at(source, i + 1) == 47 { 
            while i < len && byte_at(source, i) != 10 {
                i = i + 1; col = col + 1;
            }
        } else {
            let start_line = line;
            let start_col = col;

            if c >= 48 && c <= 57 { 
                let num_str = "";
                while i < len {
                    let nc = byte_at(source, i);
                    if (nc >= 48 && nc <= 57) || nc == 46 {
                        num_str = num_str + bytes_to_str([nc]);
                        i = i + 1; col = col + 1;
                    } else {
                        break;
                    }
                }
                push(tokens, make_token("Number", num_str, num_str, start_line, start_col));
            } 
            else if c == 34 { 
                let val = "";
                let has_interp = false;
                i = i + 1; col = col + 1;
                
                while i < len && byte_at(source, i) != 34 {
                    let nc = byte_at(source, i);
                    if nc == 92 {
                        i = i + 1; col = col + 1;
                        if i < len {
                            let esc = byte_at(source, i);
                            if esc == 110 { val = val + "\n"; }
                            else if esc == 116 { val = val + "\t"; }
                            else if esc == 114 { val = val + "\r"; }
                            else { val = val + bytes_to_str([esc]); }
                            i = i + 1; col = col + 1;
                        }
                    } else if nc == 36 && i + 1 < len && byte_at(source, i + 1) == 123 {
                        has_interp = true;
                        val = val + "$" + "{";
                        i = i + 2; col = col + 2;
                    } else {
                        val = val + bytes_to_str([nc]);
                        i = i + 1; col = col + 1;
                    }
                }
                if i >= len { throw "Unterminated string at " + str(start_line) + ":" + str(start_col); }
                i = i + 1; col = col + 1;
                
                if has_interp {
                    push(tokens, make_token("StringInterp", "\"" + val + "\"", val, start_line, start_col));
                } else {
                    push(tokens, make_token("String", "\"" + val + "\"", val, start_line, start_col));
                }
            } 
            else if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 { 
                let ident = "";
                while i < len {
                    let nc = byte_at(source, i);
                    if (nc >= 65 && nc <= 90) || (nc >= 97 && nc <= 122) || (nc >= 48 && nc <= 57) || nc == 95 {
                        ident = ident + bytes_to_str([nc]);
                        i = i + 1; col = col + 1;
                    } else {
                        break;
                    }
                }
                
                let kw_type = "Ident";
                if ident == "let" { kw_type = "Let"; }
                else if ident == "fn" { kw_type = "Fn"; }
                else if ident == "if" { kw_type = "If"; }
                else if ident == "else" { kw_type = "Else"; }
                else if ident == "while" { kw_type = "While"; }
                else if ident == "for" { kw_type = "For"; }
                else if ident == "in" { kw_type = "In"; }
                else if ident == "return" { kw_type = "Return"; }
                else if ident == "print" { kw_type = "Print"; }
                else if ident == "true" { kw_type = "True"; }
                else if ident == "false" { kw_type = "False"; }
                else if ident == "div" { kw_type = "Div"; }
                else if ident == "break" { kw_type = "Break"; }
                else if ident == "continue" { kw_type = "Continue"; }
                else if ident == "try" { kw_type = "Try"; }
                else if ident == "catch" { kw_type = "Catch"; }
                else if ident == "throw" { kw_type = "Throw"; }
                else if ident == "import" { kw_type = "Import"; }
                else if ident == "struct" { kw_type = "Struct"; }
                else if ident == "asm" { kw_type = "Asm"; }
                else if ident == "match" { kw_type = "Match"; }
                
                push(tokens, make_token(kw_type, ident, "", start_line, start_col));
            } 
            else {
                let next_c = 0;
                if i + 1 < len { next_c = byte_at(source, i + 1); }
                
                let type = "";
                let length = 1;
                
                if c == 40 { type = "LParen"; }
                else if c == 41 { type = "RParen"; }
                else if c == 123 { type = "LBrace"; }
                else if c == 125 { type = "RBrace"; }
                else if c == 91 { type = "LBracket"; }
                else if c == 93 { type = "RBracket"; }
                else if c == 59 { type = "Semi"; }
                else if c == 44 { type = "Comma"; }
                else if c == 58 { type = "Colon"; }
                else if c == 46 { type = "Dot"; }
                else if c == 63 { type = "Question"; }
                else if c == 37 { type = "Percent"; }
                else if c == 43 {
                    if next_c == 61 { type = "PlusEq"; length = 2; }
                    else if next_c == 43 { type = "PlusPlus"; length = 2; }
                    else { type = "Plus"; }
                }
                else if c == 45 {
                    if next_c == 61 { type = "MinusEq"; length = 2; }
                    else if next_c == 45 { type = "MinusMinus"; length = 2; }
                    else { type = "Minus"; }
                }
                else if c == 42 {
                    if next_c == 61 { type = "StarEq"; length = 2; }
                    else { type = "Star"; }
                }
                else if c == 47 {
                    if next_c == 61 { type = "SlashEq"; length = 2; }
                    else { type = "Slash"; }
                }
                else if c == 61 {
                    if next_c == 61 { type = "EqEq"; length = 2; }
                    else { type = "Eq"; }
                }
                else if c == 33 {
                    if next_c == 61 { type = "NotEq"; length = 2; }
                    else { type = "Bang"; }
                }
                else if c == 60 {
                    if next_c == 61 { type = "LtEq"; length = 2; }
                    else { type = "Lt"; }
                }
                else if c == 62 {
                    if next_c == 61 { type = "GtEq"; length = 2; }
                    else { type = "Gt"; }
                }
                else if c == 38 {
                    if next_c == 38 { type = "And"; length = 2; }
                    else { throw "Unexpected & at line " + str(start_line); }
                }
                else if c == 124 {
                    if next_c == 124 { type = "Or"; length = 2; }
                    else { throw "Unexpected | at line " + str(start_line); }
                }
                else {
                    throw "Unexpected character: " + bytes_to_str([c]) + " at line " + str(start_line);
                }
                
                let lex = byte_substr(source, i, i + length);
                push(tokens, make_token(type, lex, "", start_line, start_col));
                i = i + length; col = col + length;
            }
        }
    }
    
    push(tokens, make_token("Eof", "", "", line, col));
    return tokens;
}