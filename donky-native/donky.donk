// lexer.donk â€” Self-Hosted Donky Lexer
// Usage: .\target\release\donky-native.exe vm lexer.donk <file.donk>

struct Token {
    type: string,
    lexeme: string,
    literal: string,
    line: number,
    col: number
}

fn make_token(type, lexeme, literal, line, col) -> map {
    return {
        "type": type,
        "lexeme": lexeme,
        "literal": literal,
        "line": line,
        "col": col
    };
}

fn tokenize(source) -> array {
    let tokens = [];
    let i = 0;
    let line = 1;
    let col = 1;
    let len = len(source);

    while i < len {
        let c = byte_at(source, i);
        
        // Whitespace
        if c == 32 || c == 9 || c == 13 { 
            i = i + 1; col = col + 1;
        } else if c == 10 { 
            i = i + 1; line = line + 1; col = 1;
        } 
        // Comments (//)
        else if c == 47 && i + 1 < len && byte_at(source, i + 1) == 47 { 
            while i < len && byte_at(source, i) != 10 {
                i = i + 1; col = col + 1;
            }
        } else {
            let start_line = line;
            let start_col = col;

            // Numbers
            if c >= 48 && c <= 57 { 
                let num_str = "";
                while i < len {
                    let nc = byte_at(source, i);
                    if (nc >= 48 && nc <= 57) || nc == 46 { // digit or dot
                        num_str = num_str + bytes_to_str([nc]);
                        i = i + 1; col = col + 1;
                    } else {
                        break;
                    }
                }
                push(tokens, make_token("Number", num_str, num_str, start_line, start_col));
            } 
            // Strings
            else if c == 34 { 
                let val = "";
                let has_interp = false;
                i = i + 1; col = col + 1; // skip opening "
                
                while i < len && byte_at(source, i) != 34 {
                    let nc = byte_at(source, i);
                    if nc == 92 { // backslash
                        i = i + 1; col = col + 1;
                        if i < len {
                            let esc = byte_at(source, i);
                            if esc == 110 { val = val + "\n"; } // n
                            else if esc == 116 { val = val + "\t"; } // t
                            else if esc == 114 { val = val + "\r"; } // r
                            else { val = val + bytes_to_str([esc]); }
                            i = i + 1; col = col + 1;
                        }
                    } else if nc == 36 && i + 1 < len && byte_at(source, i + 1) == 123 { // ${
                        has_interp = true;
                        val = val + "$" + "{";
                        i = i + 2; col = col + 2;
                    } else {
                        val = val + bytes_to_str([nc]);
                        i = i + 1; col = col + 1;
                    }
                }
                if i >= len { throw "Unterminated string at " + str(start_line) + ":" + str(start_col); }
                i = i + 1; col = col + 1; // skip closing "
                
                if has_interp {
                    push(tokens, make_token("StringInterp", "\"" + val + "\"", val, start_line, start_col));
                } else {
                    push(tokens, make_token("String", "\"" + val + "\"", val, start_line, start_col));
                }
            } 
            // Identifiers & Keywords
            else if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 { 
                let ident = "";
                while i < len {
                    let nc = byte_at(source, i);
                    if (nc >= 65 && nc <= 90) || (nc >= 97 && nc <= 122) || (nc >= 48 && nc <= 57) || nc == 95 {
                        ident = ident + bytes_to_str([nc]);
                        i = i + 1; col = col + 1;
                    } else {
                        break;
                    }
                }
                
                let kw_type = "Ident";
                if ident == "let" { kw_type = "Let"; }
                else if ident == "fn" { kw_type = "Fn"; }
                else if ident == "if" { kw_type = "If"; }
                else if ident == "else" { kw_type = "Else"; }
                else if ident == "while" { kw_type = "While"; }
                else if ident == "for" { kw_type = "For"; }
                else if ident == "in" { kw_type = "In"; }
                else if ident == "return" { kw_type = "Return"; }
                else if ident == "print" { kw_type = "Print"; }
                else if ident == "true" { kw_type = "True"; }
                else if ident == "false" { kw_type = "False"; }
                else if ident == "div" { kw_type = "Div"; }
                else if ident == "break" { kw_type = "Break"; }
                else if ident == "continue" { kw_type = "Continue"; }
                else if ident == "try" { kw_type = "Try"; }
                else if ident == "catch" { kw_type = "Catch"; }
                else if ident == "throw" { kw_type = "Throw"; }
                else if ident == "import" { kw_type = "Import"; }
                else if ident == "struct" { kw_type = "Struct"; }
                else if ident == "asm" { kw_type = "Asm"; }
                else if ident == "match" { kw_type = "Match"; }
                
                push(tokens, make_token(kw_type, ident, "", start_line, start_col));
            } 
            // Operators and Punctuation
            else {
                let next_c = 0;
                if i + 1 < len { next_c = byte_at(source, i + 1); }
                
                let type = "";
                let length = 1;
                
                if c == 40 { type = "LParen"; }
                else if c == 41 { type = "RParen"; }
                else if c == 123 { type = "LBrace"; }
                else if c == 125 { type = "RBrace"; }
                else if c == 91 { type = "LBracket"; }
                else if c == 93 { type = "RBracket"; }
                else if c == 59 { type = "Semi"; }
                else if c == 44 { type = "Comma"; }
                else if c == 58 { type = "Colon"; }
                else if c == 46 { type = "Dot"; }
                else if c == 63 { type = "Question"; }
                else if c == 37 { type = "Percent"; }
                else if c == 43 { // +
                    if next_c == 61 { type = "PlusEq"; length = 2; }
                    else if next_c == 43 { type = "PlusPlus"; length = 2; }
                    else { type = "Plus"; }
                }
                else if c == 45 { // -
                    if next_c == 61 { type = "MinusEq"; length = 2; }
                    else if next_c == 45 { type = "MinusMinus"; length = 2; }
                    else { type = "Minus"; }
                }
                else if c == 42 { // *
                    if next_c == 61 { type = "StarEq"; length = 2; }
                    else { type = "Star"; }
                }
                else if c == 47 { // /
                    if next_c == 61 { type = "SlashEq"; length = 2; }
                    else { type = "Slash"; }
                }
                else if c == 61 { // =
                    if next_c == 61 { type = "EqEq"; length = 2; }
                    else { type = "Eq"; }
                }
                else if c == 33 { // !
                    if next_c == 61 { type = "NotEq"; length = 2; }
                    else { type = "Bang"; }
                }
                else if c == 60 { // <
                    if next_c == 61 { type = "LtEq"; length = 2; }
                    else { type = "Lt"; }
                }
                else if c == 62 { // >
                    if next_c == 61 { type = "GtEq"; length = 2; }
                    else { type = "Gt"; }
                }
                else if c == 38 { // &
                    if next_c == 38 { type = "And"; length = 2; }
                    else { throw "Unexpected & at line " + str(start_line); }
                }
                else if c == 124 { // |
                    if next_c == 124 { type = "Or"; length = 2; }
                    else { throw "Unexpected | at line " + str(start_line); }
                }
                else {
                    throw "Unexpected character: " + bytes_to_str([c]) + " at line " + str(start_line);
                }
                
                let lex = byte_substr(source, i, i + length);
                push(tokens, make_token(type, lex, "", start_line, start_col));
                i = i + length; col = col + length;
            }
        }
    }
    
    push(tokens, make_token("Eof", "", "", line, col));
    return tokens;
}

fn main() {
    if len(args) < 1 {
        print("Usage: donky-native vm lexer.donk <file.donk>");
        return;
    }
    let source = read_file(args[0]);
    let tokens = tokenize(source);
    for t in tokens {
        if t["type"] == "Eof" { break; }
        print(t["type"] + " " + t["lexeme"] + " @ " + str(t["line"]) + ":" + str(t["col"]));
    }
    print("Total tokens: " + str(len(tokens)));
}

//main();
// parser.donk â€” Self-Hosted Donky Pratt Parser
// Usage: .\target\release\donky-native.exe vm parser.donk <file.donk>


struct Parser {
    tokens: array,
    current: number
}

fn make_parser(tokens) -> map {
    return { "tokens": tokens, "current": 0 };
}

fn peek(p) -> map { return p["tokens"][p["current"]]; }
fn previous(p) -> map { return p["tokens"][p["current"] - 1]; }
fn is_at_end(p) -> bool { return peek(p)["type"] == "Eof"; }
fn advance(p) -> map {
    if !is_at_end(p) { p["current"] = p["current"] + 1; }
    return previous(p);
}
fn check(p, ttype) -> bool {
    if is_at_end(p) { return false; }
    return peek(p)["type"] == ttype;
}
fn match_token(p, types) -> bool {
    for t in types {
        if check(p, t) { advance(p); return true; }
    }
    return false;
}
fn consume(p, ttype, message) -> map {
    if check(p, ttype) { return advance(p); }
    throw message + " at " + str(peek(p)["line"]) + ":" + str(peek(p)["col"]) + " (got " + peek(p)["type"] + ")";
}

// ============================================================
// Pratt Parser Binding Power
// ============================================================
fn infix_bp(ttype) -> array {
    if ttype == "Or" { return [1, 2]; }
    if ttype == "And" { return [3, 4]; }
    if ttype == "EqEq" || ttype == "NotEq" { return [5, 6]; }
    if ttype == "Lt" || ttype == "LtEq" || ttype == "Gt" || ttype == "GtEq" { return [7, 8]; }
    if ttype == "Plus" || ttype == "Minus" { return [9, 10]; }
    if ttype == "Star" || ttype == "Slash" || ttype == "Percent" || ttype == "Div" { return [11, 12]; }
    return [0, 0]; // Not an infix operator
}

fn parse_expression(p, min_bp) -> map {
    let left = prefix(p);

    // 1. Postfix operators: Index [] and Dot .
    while true {
        if match_token(p, ["LBracket"]) {
            let index = parse_expression(p, 0);
            consume(p, "RBracket", "Expected ']'");
            left = { "type": "Index", "target": left, "index": index };
        } else if match_token(p, ["Dot"]) {
            let field = consume(p, "Ident", "Expected field name")["lexeme"];
            if match_token(p, ["LParen"]) {
                let args = [];
                if !check(p, "RParen") {
                    while true {
                        push(args, parse_expression(p, 0));
                        if !match_token(p, ["Comma"]) { break; }
                    }
                }
                consume(p, "RParen", "Expected ')'");
                left = { "type": "MethodCall", "target": left, "method": field, "args": args };
            } else {
                left = { "type": "FieldAccess", "target": left, "field": field };
            }
        } else {
            break;
        }
    }

    // 2. Infix (Binary) operators
    while true {
        let ttype = peek(p)["type"];
        let bp = infix_bp(ttype);
        let l_bp = bp[0];
        let r_bp = bp[1];
        
        if l_bp == 0 || l_bp < min_bp { break; }
        
        let op = advance(p)["type"];
        let right = parse_expression(p, r_bp);
        
        left = {
            "type": "Binary",
            "left": left,
            "op": op,
            "right": right
        };
    }
    return left;
}

fn prefix(p) -> map {
    let t = advance(p);
    
    if t["type"] == "Number" {
        return { "type": "Number", "value": num(t["literal"]) };
    }
    if t["type"] == "String" {
        return { "type": "String", "value": t["literal"] };
    }
    if t["type"] == "True" { return { "type": "Bool", "value": true }; }
    if t["type"] == "False" { return { "type": "Bool", "value": false }; }
    if t["type"] == "Ident" {
        let name = t["lexeme"];
        if match_token(p, ["LParen"]) {
            let args = [];
            if !check(p, "RParen") {
                while true {
                    push(args, parse_expression(p, 0));
                    if !match_token(p, ["Comma"]) { break; }
                }
            }
            consume(p, "RParen", "Expected ')'");
            return { "type": "Call", "name": name, "args": args };
        }
        return { "type": "Ident", "name": name };
    }
    if t["type"] == "LParen" {
        let expr = parse_expression(p, 0);
        consume(p, "RParen", "Expected ')'");
        return expr;
    }
    if t["type"] == "Minus" || t["type"] == "Bang" {
        let right = parse_expression(p, 13);
        return { "type": "Unary", "op": t["type"], "right": right };
    }
    if t["type"] == "LBracket" {
        let elements = [];
        if !check(p, "RBracket") {
            while true {
                push(elements, parse_expression(p, 0));
                if !match_token(p, ["Comma"]) { break; }
            }
        }
        consume(p, "RBracket", "Expected ']'");
        return { "type": "Array", "elements": elements };
    }
    if t["type"] == "LBrace" {
        let pairs = [];
        if !check(p, "RBrace") {
            while true {
                let key = parse_expression(p, 0);
                consume(p, "Colon", "Expected ':'");
                let val = parse_expression(p, 0);
                push(pairs, [key, val]);
                if !match_token(p, ["Comma"]) { break; }
            }
        }
        consume(p, "RBrace", "Expected '}'");
        return { "type": "Map", "pairs": pairs };
    }
    if t["type"] == "Fn" {
        consume(p, "LParen", "Expected '('");
        let params = [];
        if !check(p, "RParen") {
            while true {
                push(params, consume(p, "Ident", "Expected param")["lexeme"]);
                if !match_token(p, ["Comma"]) { break; }
            }
        }
        consume(p, "RParen", "Expected ')'");
        if match_token(p, ["Minus"]) { match_token(p, ["Gt"]); if check(p, "Ident") { advance(p); } }
        let body = statement(p);
        return { "type": "Function", "params": params, "body": body };
    }
    throw "Unexpected token in prefix: " + t["type"];
}

fn statement(p) -> map {
    if match_token(p, ["Import"]) {
        let path = consume(p, "String", "Expected path string")["literal"];
        consume(p, "Semi", "Expected ';'");
        return { "type": "Import", "path": path };
    }
    
    if match_token(p, ["Struct"]) {
        let name = consume(p, "Ident", "Expected struct name")["lexeme"];
        consume(p, "LBrace", "Expected '{'");
        let fields = [];
        while !check(p, "RBrace") && !is_at_end(p) {
            let f_name = consume(p, "Ident", "Expected field name")["lexeme"];
            consume(p, "Colon", "Expected ':'");
            let f_type = consume(p, "Ident", "Expected type")["lexeme"];
            push(fields, { "name": f_name, "type": f_type });
            match_token(p, ["Comma"]);
        }
        consume(p, "RBrace", "Expected '}'");
        return { "type": "Struct", "name": name, "fields": fields };
    }

    if match_token(p, ["Let"]) {
        let name = consume(p, "Ident", "Expected var name")["lexeme"];
        consume(p, "Eq", "Expected '='");
        let expr = parse_expression(p, 0);
        consume(p, "Semi", "Expected ';'");
        return { "type": "Let", "name": name, "expr": expr };
    }
    
    if match_token(p, ["Print"]) {
        consume(p, "LParen", "Expected '('");
        let expr = parse_expression(p, 0);
        consume(p, "RParen", "Expected ')'");
        consume(p, "Semi", "Expected ';'");
        return { "type": "Print", "expr": expr };
    }
    
    if match_token(p, ["LBrace"]) {
        let stmts = [];
        while !check(p, "RBrace") && !is_at_end(p) {
            push(stmts, statement(p));
        }
        consume(p, "RBrace", "Expected '}'");
        return { "type": "Block", "stmts": stmts };
    }
    
    if match_token(p, ["If"]) {
        let cond = parse_expression(p, 0);
        let then_b = statement(p);
        let else_b = null;
        if match_token(p, ["Else"]) {
            else_b = statement(p);
        }
        return { "type": "If", "cond": cond, "then": then_b, "else": else_b };
    }
    
    if match_token(p, ["While"]) {
        let cond = parse_expression(p, 0);
        let body = statement(p);
        return { "type": "While", "cond": cond, "body": body };
    }
    
    if match_token(p, ["For"]) {
        let name = consume(p, "Ident", "Expected loop var")["lexeme"];
        consume(p, "In", "Expected 'in'");
        let iter = parse_expression(p, 0);
        let body = statement(p);
        return { "type": "For", "var": name, "iter": iter, "body": body };
    }
    
    if match_token(p, ["Fn"]) {
        let name = consume(p, "Ident", "Expected function name")["lexeme"];
        consume(p, "LParen", "Expected '('");
        let params = [];
        if !check(p, "RParen") {
            while true {
                push(params, consume(p, "Ident", "Expected param")["lexeme"]);
                if !match_token(p, ["Comma"]) { break; }
            }
        }
        consume(p, "RParen", "Expected ')'");
        if match_token(p, ["Minus"]) { match_token(p, ["Gt"]); if check(p, "Ident") { advance(p); } }
        let body = statement(p);
        return { "type": "Function", "name": name, "params": params, "body": body };
    }
    
    if match_token(p, ["Return"]) {
        let expr = null;
        if !check(p, "Semi") { expr = parse_expression(p, 0); }
        consume(p, "Semi", "Expected ';'");
        return { "type": "Return", "expr": expr };
    }
    
    if match_token(p, ["Throw"]) {
        let expr = parse_expression(p, 0);
        consume(p, "Semi", "Expected ';'");
        return { "type": "Throw", "expr": expr };
    }
    
    if match_token(p, ["Break"]) {
        consume(p, "Semi", "Expected ';'");
        return { "type": "Break" };
    }
    
    if match_token(p, ["Continue"]) {
        consume(p, "Semi", "Expected ';'");
        return { "type": "Continue" };
    }

    if match_token(p, ["Semi"]) { return { "type": "Empty" }; }

    let expr = parse_expression(p, 0);
    if match_token(p, ["Eq"]) {
        let val = parse_expression(p, 0);
        consume(p, "Semi", "Expected ';'");
        return { "type": "Assign", "target": expr, "val": val };
    }
    consume(p, "Semi", "Expected ';'");
    return { "type": "ExprStmt", "expr": expr };
}

fn parse(tokens) -> array {
    let p = make_parser(tokens);
    let statements = [];
    while !is_at_end(p) {
        push(statements, statement(p));
    }
    return statements;
}

fn main() {
    if len(args) < 1 {
        print("Usage: donky-native vm parser.donk <file.donk>");
        return;
    }
    let source = read_file(args[0]);
    let tokens = tokenize(source);
    print("Lexed " + str(len(tokens)) + " tokens. Parsing...");
    let ast = parse(tokens);
    print("Parsed successfully! Top-level statements: " + str(len(ast)));
}

//main();
// compiler.donk â€” Self-Hosted Donky Compiler
// Usage: .\target\release\donky-native.exe vm compiler.donk <file.donk>


struct Compiler {
    code: array,
    locals: map,
    next_local: number
}

fn make_compiler() -> map {
    return { "code": [], "locals": {}, "next_local": 0 };
}

fn emit(c, instruction) {
    push(c["code"], instruction);
}

fn compile_expr(c, expr) {
    if expr == null { return; }
    let t = expr["type"];

    if t == "Number" {
        emit(c, "PushNumber " + str(expr["value"]));
    } 
    else if t == "String" {
        emit(c, "PushString " + expr["value"]);
    }
    else if t == "Bool" {
        emit(c, "PushBool " + str(expr["value"]));
    }
    else if t == "Ident" {
        emit(c, "GetLocal " + expr["name"]);
    }
    else if t == "Binary" {
        compile_expr(c, expr["left"]);
        compile_expr(c, expr["right"]);
        emit(c, "BinOp " + expr["op"]);
    }
    else if t == "Unary" {
        compile_expr(c, expr["right"]);
        emit(c, "UnaryOp " + expr["op"]);
    }
    else if t == "Index" {
        compile_expr(c, expr["target"]);
        compile_expr(c, expr["index"]);
        emit(c, "Index");
    }
    else if t == "Array" {
        for el in expr["elements"] { compile_expr(c, el); }
        emit(c, "MakeArray " + str(len(expr["elements"])));
    }
    else if t == "Map" {
        for pair in expr["pairs"] {
            compile_expr(c, pair[0]);
            compile_expr(c, pair[1]);
        }
        emit(c, "MakeMap " + str(len(expr["pairs"])));
    }
    else if t == "Call" {
        let args = expr["args"];
        // Compile in forward order now
        for a in args {
            compile_expr(c, a);
        }
        emit(c, "Call " + expr["name"] + " " + str(len(args)));
    }
    else {
        emit(c, "// Unhandled Expr: " + t);
    }
}

fn compile_stmt(c, stmt) {
    if stmt == null { return; }
    let t = stmt["type"];

    if t == "Import" {
        let path = stmt["path"];
        let source = read_file(path);
        let tokens = tokenize(source);
        let ast = parse(tokens);
        for s in ast {
            compile_stmt(c, s);
        }
    }
    else if t == "Struct" {
        // Structs are dynamic maps in Donky, we skip them during compilation.
    }
    else if t == "Function" {
        let jmp_idx = len(c["code"]);
        emit(c, "Jump 0");
        
        let func_start = len(c["code"]);
        
        let params = stmt["params"];
        let i = len(params) - 1;
        while i >= 0 {
            emit(c, "SetLocal " + params[i]);
            i = i - 1;
        }
        
        compile_stmt(c, stmt["body"]);
        emit(c, "PushNull");
        emit(c, "Return");
        
        c["code"][jmp_idx] = "Jump " + str(len(c["code"]));
        
        c["locals"][stmt["name"]] = func_start;
        emit(c, "DefineFunction " + stmt["name"] + " " + str(func_start));
    }
    else if t == "Return" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Return");
    }
    else if t == "Throw" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Throw");
    }
    else if t == "Let" {
        compile_expr(c, stmt["expr"]);
        let name = stmt["name"];
        c["locals"][name] = c["next_local"];
        c["next_local"] = c["next_local"] + 1;
        emit(c, "SetLocal " + name);
    }
    else if t == "Assign" {
        let target = stmt["target"];
        let val = stmt["val"];
        if target["type"] == "Ident" {
            compile_expr(c, val);
            emit(c, "SetLocal " + target["name"]);
        } else if target["type"] == "Index" {
            compile_expr(c, target["target"]);
            compile_expr(c, target["index"]);
            compile_expr(c, val);
            emit(c, "IndexSet");
        }
    }
    else if t == "Print" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Print");
    }
    else if t == "ExprStmt" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Pop");
    }
    else if t == "Block" {
        let stmts = stmt["stmts"];
        for s in stmts { compile_stmt(c, s); }
    }
    else if t == "If" {
        compile_expr(c, stmt["cond"]);
        let jmp_if_idx = len(c["code"]);
        emit(c, "JumpIfFalse 0");
        
        compile_stmt(c, stmt["then"]);
        
        if stmt["else"] != null {
            let jmp_over_idx = len(c["code"]);
            emit(c, "Jump 0");
            c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
            compile_stmt(c, stmt["else"]);
            c["code"][jmp_over_idx] = "Jump " + str(len(c["code"]));
        } else {
            c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
        }
    }
    else if t == "While" {
        let loop_start = len(c["code"]);
        compile_expr(c, stmt["cond"]);
        let jmp_if_idx = len(c["code"]);
        emit(c, "JumpIfFalse 0");
        compile_stmt(c, stmt["body"]);
        emit(c, "Jump " + str(loop_start));
        c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
    }
    else if t == "For" {
        let var_name = stmt["var"];
        let iter_expr = stmt["iter"];
        let body = stmt["body"];
        let iter_slot = "__iter_" + str(len(c["code"]));
        let idx_slot = "__idx_" + str(len(c["code"]));
        
        compile_expr(c, iter_expr);
        emit(c, "SetLocal " + iter_slot);
        emit(c, "PushNumber 0");
        emit(c, "SetLocal " + idx_slot);
        
        let loop_start = len(c["code"]);
        emit(c, "GetLocal " + idx_slot);
        emit(c, "GetLocal " + iter_slot);
        emit(c, "Call len 1");
        emit(c, "BinOp Lt");
        let jmp_if_idx = len(c["code"]);
        emit(c, "JumpIfFalse 0");
        
        emit(c, "GetLocal " + iter_slot);
        emit(c, "GetLocal " + idx_slot);
        emit(c, "Index");
        emit(c, "SetLocal " + var_name);
        
        compile_stmt(c, body);
        
        emit(c, "GetLocal " + idx_slot);
        emit(c, "PushNumber 1");
        emit(c, "BinOp Plus");
        emit(c, "SetLocal " + idx_slot);
        
        emit(c, "Jump " + str(loop_start));
        c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
    }
}

fn compile(ast) -> array {
    let c = make_compiler();
    for stmt in ast { compile_stmt(c, stmt); }
    emit(c, "Halt");
    return c["code"];
}

fn main() {
    if len(args) < 1 { return; }
    let source = read_file(args[0]);
    let tokens = tokenize(source);
    let ast = parse(tokens);
    let bytecode = compile(ast);
    let out_path = args[0] + ".bytecode";
    write_file(out_path, join(bytecode, "\n"));
    print("Compiled to " + out_path);
}

fn boot() {
    if len(args) < 1 {
        print("usage: donky-native vm donky.donk <program.donk>");
        return;
    }

    // Self-host mode: compile donky.donk with itself, then run the result
    if args[0] == "donky.donk" {
        print("=== SELF-HOST MODE ===");
        let src = read_file("donky.donk");
        let toks = tokenize(src);
        let tree = parse(toks);
        let self_bc = compile(tree);
        print("self-compiled donky.donk: " + str(len(self_bc)) + " ops");
        print("=== RUNNING SELF-COMPILED COMPILER ON test_math.donk ===");
        run_bytecode(self_bc, ["test_math.donk"]);
        return;
    }

    let path = args[0];
    let source = read_file(path);
    let tokens = tokenize(source);
    let ast = parse(tokens);
    let bytecode = compile(ast);
    let bc_path = path + ".bytecode";
    write_file(bc_path, join(bytecode, "\n"));
    print("compiled " + path + " -> " + bc_path + " (" + str(len(bytecode)) + " ops)");
    let bc_lines = split(read_file(bc_path), "\n");
    run_bytecode(bc_lines, [path]);
}

boot();
// vm.donk â€” Self-Hosted Donky Virtual Machine

fn eval_op(op, a, b) {
    if op == "Plus" { return a + b; }
    if op == "Minus" { return a - b; }
    if op == "Star" { return a * b; }
    if op == "Slash" { return a / b; }
    if op == "EqEq" { return a == b; }
    if op == "NotEq" { return a != b; }
    if op == "Lt" { return a < b; }
    if op == "Gt" { return a > b; }
    if op == "LtEq" { return a <= b; }
    if op == "GtEq" { return a >= b; }
    throw "Unknown operator: " + op;
}

fn call_builtin(name, args) {
    if name == "len" { return len(args[0]); }
    if name == "push" { push(args[0], args[1]); return null; }
    if name == "pop" { return pop(args[0]); }
    if name == "split" { return split(args[0], args[1]); }
    if name == "join" { return join(args[0], args[1]); }
    if name == "num" { return num(args[0]); }
    if name == "str" { return str(args[0]); }
    if name == "read_file" { return read_file(args[0]); }
    if name == "write_file" { write_file(args[0], args[1]); return null; }
    if name == "byte_at" { return byte_at(args[0], args[1]); }
    if name == "byte_substr" { return byte_substr(args[0], args[1], args[2]); }
    if name == "bytes_to_str" { return bytes_to_str(args[0]); }
    if name == "type" { return type(args[0]); }
    if name == "contains" { return contains(args[0], args[1]); }
    if name == "is_null" { return args[0] == null; }
    throw "Unknown builtin: " + name;
}

fn run_bytecode(bytecode, script_args) {
    let stack = [];
    let locals = {};
    let globals = {};
    let call_stack = [];
    
    globals["args"] = script_args;
    
    let ip = 0;
    let len_bc = len(bytecode);

    while ip < len_bc {
        let instruction = bytecode[ip];
        let parts = split(instruction, " ");
        let op = parts[0];
        let arg = "";
        if len(parts) > 1 {
            let arg_parts = [];
            let i = 1;
            while i < len(parts) { push(arg_parts, parts[i]); i = i + 1; }
            arg = join(arg_parts, " ");
        }

        if op == "PushNumber" { push(stack, num(arg)); }
        else if op == "PushString" { push(stack, arg); }
        else if op == "PushBool" { push(stack, arg == "true"); }
        else if op == "PushNull" { push(stack, null); }
        else if op == "Pop" { pop(stack); }
        else if op == "SetLocal" { locals[arg] = pop(stack); }
        else if op == "GetLocal" { 
            if contains(locals, arg) { push(stack, locals[arg]); } 
            else if contains(globals, arg) { push(stack, globals[arg]); }
            else { throw "Undefined variable: " + arg; }
        }
        else if op == "BinOp" {
            let b = pop(stack);
            let a = pop(stack);
            push(stack, eval_op(arg, a, b));
        }
        else if op == "UnaryOp" {
            let val = pop(stack);
            if arg == "Minus" { push(stack, -val); }
            else if arg == "Bang" { push(stack, !val); }
        }
        else if op == "Print" { print(pop(stack)); }
        else if op == "Jump" { ip = num(arg); continue; }
        else if op == "JumpIfFalse" {
            let cond = pop(stack);
            if !cond { ip = num(arg); continue; }
        }
        else if op == "DefineFunction" {
            globals[parts[1]] = num(parts[2]);
        }
        else if op == "Call" {
            let func_name = parts[1];
            let arg_count = num(parts[2]);
            
            if !contains(globals, func_name) {
                let args = [];
                let i = 0;
                while i < arg_count { push(args, pop(stack)); i = i + 1; }
                let real_args = [];
                let j = len(args) - 1;
                while j >= 0 { push(real_args, args[j]); j = j - 1; }
                let res = call_builtin(func_name, real_args);
                push(stack, res);
            } else {
                let func_addr = globals[func_name];
                push(call_stack, { "ip": ip + 1, "locals": locals });
                locals = {};
                ip = func_addr;
                continue;
            }
        }
        else if op == "Return" {
            let ret_val = pop(stack);
            if len(call_stack) > 0 {
                let frame = pop(call_stack);
                ip = frame["ip"];
                locals = frame["locals"];
                push(stack, ret_val);
            } else { break; }
            continue;
        }
        else if op == "MakeArray" {
            let count = num(arg);
            let arr = [];
            let i = 0;
            while i < count { push(arr, pop(stack)); i = i + 1; }
            let final_arr = [];
            let j = len(arr) - 1;
            while j >= 0 { push(final_arr, arr[j]); j = j - 1; }
            push(stack, final_arr);
        }
        else if op == "MakeMap" {
            let count = num(arg);
            let map = {};
            let i = 0;
            while i < count {
                let val = pop(stack);
                let key = pop(stack);
                map[key] = val;
                i = i + 1;
            }
            push(stack, map);
        }
        else if op == "Index" {
            let idx = pop(stack);
            let target = pop(stack);
            push(stack, target[idx]);
        }
        else if op == "IndexSet" {
            let val = pop(stack);
            let idx = pop(stack);
            let target = pop(stack);
            target[idx] = val;
        }
        else if op == "Throw" {
            let val = pop(stack);
            throw "Exception: " + str(val);
        }
        else if op == "Halt" { break; }
        
        ip = ip + 1;
    }
}