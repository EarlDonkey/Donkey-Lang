// compiler.donk — Self-Hosted Donky Compiler
// Usage: .\target\release\donky-native.exe vm compiler.donk <file.donk>

import "parser.donk";

struct Compiler {
    code: array,
    locals: map,
    next_local: number
}

fn make_compiler() -> map {
    return { "code": [], "locals": {}, "next_local": 0 };
}

fn emit(c, instruction) {
    push(c["code"], instruction);
}

fn compile_expr(c, expr) {
    if expr == null { return; }
    let t = expr["type"];

    if t == "Number" {
        emit(c, "PushNumber " + str(expr["value"]));
    } 
    else if t == "String" {
        emit(c, "PushString " + expr["value"]);
    }
    else if t == "Bool" {
        emit(c, "PushBool " + str(expr["value"]));
    }
    else if t == "Ident" {
        emit(c, "GetLocal " + expr["name"]);
    }
    else if t == "Binary" {
        compile_expr(c, expr["left"]);
        compile_expr(c, expr["right"]);
        emit(c, "BinOp " + expr["op"]);
    }
    else if t == "Unary" {
        compile_expr(c, expr["right"]);
        emit(c, "UnaryOp " + expr["op"]);
    }
    else if t == "Call" {
        // Compile arguments in reverse order for stack machine
        let args = expr["args"];
        let i = len(args) - 1;
        while i >= 0 {
            compile_expr(c, args[i]);
            i = i - 1;
        }
        emit(c, "Call " + expr["name"] + " " + str(len(args)));
    }
    else {
        emit(c, "// Unhandled Expr: " + t);
    }
}

fn compile_stmt(c, stmt) {
    if stmt == null { return; }
    let t = stmt["type"];

    if t == "Let" {
        compile_expr(c, stmt["expr"]);
        let name = stmt["name"];
        let slot = c["next_local"];
        c["locals"][name] = slot;
        c["next_local"] = slot + 1;
        emit(c, "SetLocal " + name);
    }
    else if t == "Assign" {
        // Just simple assignment for now
        let name = stmt["target"]["name"];
        compile_expr(c, stmt["val"]);
        emit(c, "SetLocal " + name);
    }
    else if t == "Print" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Print");
    }
    else if t == "ExprStmt" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Pop");
    }
    else if t == "Block" {
        let stmts = stmt["stmts"];
        for s in stmts {
            compile_stmt(c, s);
        }
    }
    else if t == "If" {
        compile_expr(c, stmt["cond"]);
        let jmp_if_idx = len(c["code"]);
        emit(c, "JumpIfFalse 0"); // Patching later
        
        compile_stmt(c, stmt["then"]);
        
        if stmt["else"] != null {
            let jmp_over_idx = len(c["code"]);
            emit(c, "Jump 0");
            
            // Patch JumpIfFalse to here
            c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
            
            compile_stmt(c, stmt["else"]);
            
            // Patch Jump over to here
            c["code"][jmp_over_idx] = "Jump " + str(len(c["code"]));
        } else {
            c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
        }
    }
    else if t == "While" {
        let loop_start = len(c["code"]);
        
        compile_expr(c, stmt["cond"]);
        let jmp_if_idx = len(c["code"]);
        emit(c, "JumpIfFalse 0");
        
        compile_stmt(c, stmt["body"]);
        
        emit(c, "Jump " + str(loop_start));
        c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
    }
    else if t == "Function" {
        // We need to compile the body into a separate array,
        // but for this simple proof-of-concept we will inline it or skip it.
        // True functions require a constant pool and closures.
        emit(c, "// Skipped function compilation: " + stmt["name"]);
    }
    else {
        emit(c, "// Unhandled Stmt: " + t);
    }
}

fn compile(ast) -> array {
    let c = make_compiler();
    for stmt in ast {
        compile_stmt(c, stmt);
    }
    emit(c, "Halt");
    return c["code"];
}

fn main() {
    if len(args) < 1 {
        print("Usage: donky-native vm compiler.donk <file.donk>");
        return;
    }
    let source = read_file(args[0]);
    let tokens = tokenize(source);
    let ast = parse(tokens);
    
    print("--- AST Parsed. Compiling to Bytecode ---");
    let bytecode = compile(ast);
    
    print("=== Generated Bytecode ===");
    for op in bytecode {
        print(op);
    }
}

//main();