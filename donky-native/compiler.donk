// compiler.donk — Self-Hosted Donky Compiler (with full peephole)

import "parser.donk";

struct Compiler {
    code: array,
    locals: map,
    next_local: number
}

fn make_compiler() -> map {
    return { "code": [], "locals": {}, "next_local": 0 };
}

fn emit(c, instruction) {
    push(c["code"], instruction);
}

fn compile_expr(c, expr) {
    if expr == null { return; }
    let t = expr["type"];

    if t == "Number" {
        emit(c, "PushNumber " + str(expr["value"]));
    } 
    else if t == "String" {
        emit(c, "PushString \"" + expr["value"] + "\"");
    }
    else if t == "Bool" {
        emit(c, "PushBool " + str(expr["value"]));
    }
    else if t == "Ident" {
        emit(c, "GetLocal " + expr["name"]);
    }
    else if t == "Binary" {
        compile_expr(c, expr["left"]);
        compile_expr(c, expr["right"]);
        emit(c, "BinOp " + expr["op"]);
    }
    else if t == "Unary" {
        compile_expr(c, expr["right"]);
        emit(c, "UnaryOp " + expr["op"]);
    }
    else if t == "Index" {
        compile_expr(c, expr["target"]);
        compile_expr(c, expr["index"]);
        emit(c, "Index");
    }
    else if t == "Array" {
        for el in expr["elements"] { compile_expr(c, el); }
        emit(c, "MakeArray " + str(len(expr["elements"])));
    }
    else if t == "Map" {
        for pair in expr["pairs"] {
            compile_expr(c, pair[0]);
            compile_expr(c, pair[1]);
        }
        emit(c, "MakeMap " + str(len(expr["pairs"])));
    }
    else if t == "Call" {
        let args = expr["args"];
        for a in args { compile_expr(c, a); }
        emit(c, "Call " + expr["name"] + " " + str(len(args)));
    }
    else {
        emit(c, "// Unhandled Expr: " + t);
    }
}

fn compile_stmt(c, stmt) {
    if stmt == null { return; }
    let t = stmt["type"];

    if t == "Import" {
        let path = stmt["path"];
        let source = read_file(path);
        let tokens = tokenize(source);
        let ast = parse(tokens);
        for s in ast { compile_stmt(c, s); }
    }
    else if t == "Struct" {
    }
    else if t == "Function" {
        let jmp_idx = len(c["code"]);
        emit(c, "Jump 0");

        let func_start = len(c["code"]);

        let params = stmt["params"];
        let i = len(params) - 1;
        while i >= 0 {
            emit(c, "SetLocal " + params[i]);
            i = i - 1;
        }

        compile_stmt(c, stmt["body"]);
        emit(c, "PushNull");
        emit(c, "Return");

        c["code"][jmp_idx] = "Jump " + str(len(c["code"]));

        c["locals"][stmt["name"]] = func_start;
        emit(c, "DefineFunction " + stmt["name"] + " " + str(func_start));
    }
    else if t == "Return" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Return");
    }
    else if t == "Throw" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Throw");
    }
    else if t == "Let" {
        compile_expr(c, stmt["expr"]);
        let name = stmt["name"];
        c["locals"][name] = c["next_local"];
        c["next_local"] = c["next_local"] + 1;
        emit(c, "SetLocal " + name);
    }
    else if t == "Assign" {
        let target = stmt["target"];
        let val = stmt["val"];
        if target["type"] == "Ident" {
            compile_expr(c, val);
            emit(c, "SetLocal " + target["name"]);
        } else if target["type"] == "Index" {
            compile_expr(c, target["target"]);
            compile_expr(c, target["index"]);
            compile_expr(c, val);
            emit(c, "IndexSet");
        }
    }
    else if t == "Print" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Print");
    }
    else if t == "ExprStmt" {
        compile_expr(c, stmt["expr"]);
        emit(c, "Pop");
    }
    else if t == "Block" {
        let stmts = stmt["stmts"];
        for s in stmts { compile_stmt(c, s); }
    }
    else if t == "If" {
        compile_expr(c, stmt["cond"]);
        let jmp_if_idx = len(c["code"]);
        emit(c, "JumpIfFalse 0");

        compile_stmt(c, stmt["then"]);

        if stmt["else"] != null {
            let jmp_over_idx = len(c["code"]);
            emit(c, "Jump 0");
            c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
            compile_stmt(c, stmt["else"]);
            c["code"][jmp_over_idx] = "Jump " + str(len(c["code"]));
        } else {
            c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
        }
    }
    else if t == "While" {
        let loop_start = len(c["code"]);
        compile_expr(c, stmt["cond"]);
        let jmp_if_idx = len(c["code"]);
        emit(c, "JumpIfFalse 0");
        compile_stmt(c, stmt["body"]);
        emit(c, "Jump " + str(loop_start));
        c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
    }
    else if t == "For" {
        let var_name = stmt["var"];
        let iter_expr = stmt["iter"];
        let body = stmt["body"];
        let iter_slot = "__iter_" + str(len(c["code"]));
        let idx_slot = "__idx_" + str(len(c["code"]));

        compile_expr(c, iter_expr);
        emit(c, "SetLocal " + iter_slot);
        emit(c, "PushNumber 0");
        emit(c, "SetLocal " + idx_slot);

        let loop_start = len(c["code"]);
        emit(c, "GetLocal " + idx_slot);
        emit(c, "GetLocal " + iter_slot);
        emit(c, "Call len 1");
        emit(c, "BinOp Lt");
        let jmp_if_idx = len(c["code"]);
        emit(c, "JumpIfFalse 0");

        emit(c, "GetLocal " + iter_slot);
        emit(c, "GetLocal " + idx_slot);
        emit(c, "Index");
        emit(c, "SetLocal " + var_name);

        compile_stmt(c, body);

        emit(c, "GetLocal " + idx_slot);
        emit(c, "PushNumber 1");
        emit(c, "BinOp Plus");
        emit(c, "SetLocal " + idx_slot);

        emit(c, "Jump " + str(loop_start));
        c["code"][jmp_if_idx] = "JumpIfFalse " + str(len(c["code"]));
    }
}

// ============================================================
// Peephole optimizer
// ============================================================

fn _collect_targets(code) -> map {
    let targets = {};
    let i = 0;
    while i < len(code) {
        let parts = split(code[i], " ");
        let op = parts[0];
        if op == "Jump" || op == "JumpIfFalse" || op == "TryStart" {
            targets[num(parts[1])] = true;
        } else if op == "DefineFunction" {
            targets[num(parts[2])] = true;
        }
        i = i + 1;
    }
    return targets;
}

fn _remap_jumps(code, old_to_new) -> array {
    let result = [];
    for instr in code {
        let parts = split(instr, " ");
        let op = parts[0];
        if op == "Jump" || op == "JumpIfFalse" || op == "TryStart" {
            let old_t = num(parts[1]);
            if contains(old_to_new, old_t) { push(result, op + " " + str(old_to_new[old_t])); }
            else { push(result, instr); }
        } else if op == "DefineFunction" {
            let old_t = num(parts[2]);
            if contains(old_to_new, old_t) { push(result, "DefineFunction " + parts[1] + " " + str(old_to_new[old_t])); }
            else { push(result, instr); }
        } else if op == "IncLocalJump" {
            let old_t = num(parts[3]);
            if contains(old_to_new, old_t) { push(result, "IncLocalJump " + parts[1] + " " + parts[2] + " " + str(old_to_new[old_t])); }
            else { push(result, instr); }
        } else if op == "JumpIfLocalCmpFalse" {
            let old_t = num(parts[4]);
            if contains(old_to_new, old_t) { push(result, "JumpIfLocalCmpFalse " + parts[1] + " " + parts[2] + " " + parts[3] + " " + str(old_to_new[old_t])); }
            else { push(result, instr); }
        } else if op == "JumpIfLocalConstCmpFalse" {
            let old_t = num(parts[4]);
            if contains(old_to_new, old_t) { push(result, "JumpIfLocalConstCmpFalse " + parts[1] + " " + parts[2] + " " + parts[3] + " " + str(old_to_new[old_t])); }
            else { push(result, instr); }
        } else {
            push(result, instr);
        }
    }
    return result;
}

fn _peephole_pass1(code) -> array {
    let targets = _collect_targets(code);
    let new_code = [];
    let old_to_new = {};
    let i = 0;
    while i < len(code) {
        old_to_new[i] = len(new_code);
        let instr = code[i];
        let parts = split(instr, " ");
        let op = parts[0];

        // Rule 1: GetLocal a; GetLocal b; BinOp op
        if op == "GetLocal" && i + 2 < len(code)
           && !contains(targets, i+1) && !contains(targets, i+2) {
            let p1 = split(code[i+1], " ");
            let p2 = split(code[i+2], " ");
            if p1[0] == "GetLocal" && p2[0] == "BinOp" {
                push(new_code, "BinLocals " + p2[1] + " " + parts[1] + " " + p1[1]);
                i = i + 3;
                continue;
            }
        }

        // Rule 5: GetLocal a; PushNumber k; BinOp(Plus|Minus); SetLocal a
        if op == "GetLocal" && i + 3 < len(code)
           && !contains(targets, i+1) && !contains(targets, i+2) && !contains(targets, i+3) {
            let p1 = split(code[i+1], " ");
            let p2 = split(code[i+2], " ");
            let p3 = split(code[i+3], " ");
            if p1[0] == "PushNumber" && p2[0] == "BinOp" && p3[0] == "SetLocal" && p3[1] == parts[1] {
                let plus = (p2[1] == "Plus");
                let minus = (p2[1] == "Minus");
                if plus || minus {
                    let k = num(p1[1]);
                    let delta = k;
                    if minus { delta = -k; }
                    push(new_code, "IncLocal " + parts[1] + " " + str(delta));
                    i = i + 4;
                    continue;
                }
            }
        }

        // Rule 6: GetLocal a; PushNumber k; BinOp(Plus|Minus) -> PushLocalAddConst/SubConst
        if op == "GetLocal" && i + 2 < len(code)
           && !contains(targets, i+1) && !contains(targets, i+2) {
            let p1 = split(code[i+1], " ");
            let p2 = split(code[i+2], " ");
            if p1[0] == "PushNumber" && p2[0] == "BinOp" {
                let plus = (p2[1] == "Plus");
                let minus = (p2[1] == "Minus");
                if plus || minus {
                    let k = num(p1[1]);
                    if plus { push(new_code, "PushLocalAddConst " + parts[1] + " " + str(k)); }
                    else { push(new_code, "PushLocalSubConst " + parts[1] + " " + str(k)); }
                    i = i + 3;
                    continue;
                }
            }
        }

        push(new_code, instr);
        i = i + 1;
    }
    old_to_new[len(code)] = len(new_code);
    return _remap_jumps(new_code, old_to_new);
}

fn _peephole_pass2(code) -> array {
    let targets = _collect_targets(code);
    let new_code = [];
    let old_to_new = {};
    let i = 0;
    while i < len(code) {
        old_to_new[i] = len(new_code);
        let instr = code[i];
        let parts = split(instr, " ");
        let op = parts[0];

        // Rule 2: BinLocals cmp a b; JumpIfFalse t
        if op == "BinLocals" && i + 1 < len(code) && !contains(targets, i+1) {
            let cmp = parts[1];
            let is_cmp = cmp == "Lt" || cmp == "Gt" || cmp == "LtEq" || cmp == "GtEq" || cmp == "EqEq" || cmp == "NotEq";
            let p1 = split(code[i+1], " ");
            if is_cmp && p1[0] == "JumpIfFalse" {
                push(new_code, "JumpIfLocalCmpFalse " + cmp + " " + parts[2] + " " + parts[3] + " " + p1[1]);
                i = i + 2;
                continue;
            }
        }

        // Rule 4: IncLocal x d; Jump t
        if op == "IncLocal" && i + 1 < len(code) && !contains(targets, i+1) {
            let p1 = split(code[i+1], " ");
            if p1[0] == "Jump" {
                push(new_code, "IncLocalJump " + parts[1] + " " + parts[2] + " " + p1[1]);
                i = i + 2;
                continue;
            }
        }

        push(new_code, instr);
        i = i + 1;
    }
    old_to_new[len(code)] = len(new_code);
    return _remap_jumps(new_code, old_to_new);
}

fn peephole(code) -> array {
    let c1 = _peephole_pass1(code);
    let c2 = _peephole_pass2(c1);
    return c2;
}

fn compile(ast) -> array {
    let c = make_compiler();
    for stmt in ast { compile_stmt(c, stmt); }
    emit(c, "Halt");
    return c["code"]; // <--- REMOVED peephole()
}

fn main() {
    if len(args) < 1 { return; }
    let source = read_file(args[0]);
    let tokens = tokenize(source);
    let ast = parse(tokens);
    let bytecode = compile(ast);
    let out_path = args[0] + ".bytecode";
    write_file(out_path, join(bytecode, "\n"));
    print("Compiled to " + out_path);
}