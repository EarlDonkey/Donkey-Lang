// json.donk — pure-Donky JSON parser and serializer
// ASCII-safe; handles strings, numbers, bools, arrays, objects.
// (Null not yet supported — will return empty string "" as placeholder.)

// ============================================================
// Parser state — byte-based to handle UTF-8 safely
// ============================================================

fn json_ws(b) -> bool {
    // space, tab, lf, cr
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn json_skip_ws(input, pos) -> num {
    let i = pos;
    while i < len(input) {
        if !json_ws(byte_at(input, i)) { break; }
        i = i + 1;
    }
    return i;
}

// Returns a 2-element array: [value, new_pos]
fn json_parse_string(input, pos) -> array {
    // input[pos] must be `"` (byte 34)
    let i = pos + 1;
    let bytes = [];
    while i < len(input) {
        let b = byte_at(input, i);
        if b == 34 {
            return [bytes_to_str(bytes), i + 1];
        }
        if b == 92 {
            // backslash escape
            let esc = byte_at(input, i + 1);
            if esc == 110 { push(bytes, 10); }        // n
            else if esc == 116 { push(bytes, 9); }    // t
            else if esc == 114 { push(bytes, 13); }   // r
            else if esc == 34 { push(bytes, 34); }    // "
            else if esc == 92 { push(bytes, 92); }    // backslash
            else if esc == 47 { push(bytes, 47); }    // /
            else { throw "json: bad escape \\" + bytes_to_str([esc]); }
            i = i + 2;
        } else {
            push(bytes, b);
            i = i + 1;
        }
    }
    throw "json: unterminated string";
}

fn json_parse_number(input, pos) -> array {
    let i = pos;
    // optional minus
    if byte_at(input, i) == 45 { i = i + 1; }
    // digits
    while i < len(input) {
        let b = byte_at(input, i);
        if b >= 48 && b <= 57 { i = i + 1; } else { break; }
    }
    // decimal
    if byte_at(input, i) == 46 {
        i = i + 1;
        while i < len(input) {
            let b = byte_at(input, i);
            if b >= 48 && b <= 57 { i = i + 1; } else { break; }
        }
    }
    // exponent
    let eb = byte_at(input, i);
    if eb == 101 || eb == 69 {  // e or E
        i = i + 1;
        let sb = byte_at(input, i);
        if sb == 43 || sb == 45 { i = i + 1; }  // + or -
        while i < len(input) {
            let b = byte_at(input, i);
            if b >= 48 && b <= 57 { i = i + 1; } else { break; }
        }
    }
    let s = byte_substr(input, pos, i);
    return [num(s), i];
}

fn json_parse_array(input, pos) -> array {
    // input[pos] == '['
    let i = json_skip_ws(input, pos + 1);
    let arr = [];
    if byte_at(input, i) == 93 {  // ']'
        return [arr, i + 1];
    }
    while true {
        i = json_skip_ws(input, i);
        let r = json_parse_value(input, i);
        push(arr, r[0]);
        i = json_skip_ws(input, r[1]);
        let b = byte_at(input, i);
        if b == 93 { return [arr, i + 1]; }
        if b != 44 { throw "json: expected , or ]"; }
        i = i + 1;
    }
}

fn json_parse_object(input, pos) -> array {
    // input[pos] == '{'
    let i = json_skip_ws(input, pos + 1);
    let obj = {};
    if byte_at(input, i) == 125 {  // '}'
        return [obj, i + 1];
    }
    while true {
        i = json_skip_ws(input, i);
        let kr = json_parse_string(input, i);
        let key = kr[0];
        i = json_skip_ws(input, kr[1]);
        if byte_at(input, i) != 58 { throw "json: expected :"; }
        i = json_skip_ws(input, i + 1);
        let vr = json_parse_value(input, i);
        obj[key] = vr[0];
        i = json_skip_ws(input, vr[1]);
        let b = byte_at(input, i);
        if b == 125 { return [obj, i + 1]; }
        if b != 44 { throw "json: expected , or }"; }
        i = i + 1;
    }
}

fn json_parse_value(input, pos) -> array {
    let i = json_skip_ws(input, pos);
    let b = byte_at(input, i);
    if b == 34 { return json_parse_string(input, i); }
    if b == 123 { return json_parse_object(input, i); }
    if b == 91 { return json_parse_array(input, i); }
    if b == 45 || (b >= 48 && b <= 57) { return json_parse_number(input, i); }
    // true / false
    if byte_substr(input, i, i + 4) == "true" {
        return [true, i + 4];
    }
    if byte_substr(input, i, i + 5) == "false" {
        return [false, i + 5];
    }
    if byte_substr(input, i, i + 4) == "null" {
        return ["", i + 4];  // placeholder for null
    }
    throw "json: unexpected char at " + str(i);
}

// Public: parse a JSON string into a Donky value
fn json_parse(input) -> any {
    if type(input) != "string" || len(trim(input)) == 0 {
        return {};
    }
    let r = json_parse_value(input, 0);
    return r[0];
}

// ============================================================
// Serializer
// ============================================================

fn json_escape_string(s) -> string {
    let out = [];
    let i = 0;
    while i < len(s) {
        let b = byte_at(s, i);
        if b == 34 { push(out, "\\\""); i = i + 1; }
        else if b == 92 { push(out, "\\\\"); i = i + 1; }
        else if b == 10 { push(out, "\\n"); i = i + 1; }
        else if b == 13 { push(out, "\\r"); i = i + 1; }
        else if b == 9  { push(out, "\\t"); i = i + 1; }
        else {
            push(out, byte_substr(s, i, i + 1));
            i = i + 1;
        }
    }
    return join(out, "");
}

fn json_stringify(value) -> string {
    let t = type(value);
    if t == "number" {
        return str(value);
    }
    if t == "bool" {
        if value { return "true"; } else { return "false"; }
    }
    if t == "string" {
        return "\"" + json_escape_string(value) + "\"";
    }
    if t == "array" {
        let parts = [];
        for item in value {
            push(parts, json_stringify(item));
        }
        return "[" + join(parts, ",") + "]";
    }
    if t == "map" {
        let parts = [];
        let ks = keys(value);
        for k in ks {
            let ks_str = str(k);
            push(parts, "\"" + json_escape_string(ks_str) + "\":" + json_stringify(value[k]));
        }
        return "{" + join(parts, ",") + "}";
    }
    // Fallback: encode as string
    return "\"" + json_escape_string(str(value)) + "\"";
}

// ============================================================
// Convenience: safe map access (no throw on missing)
// ============================================================

fn json_get(obj, key, default_value) -> any {
    if type(obj) != "map" { return default_value; }
    if !contains(obj, key) { return default_value; }
    return obj[key];
}

// ============================================================
// Self-tests (commented out so importing json.donk stays silent)
// ============================================================

fn _json_test_simple() {
    let r = json_parse("42");
    print("number: " + str(r));
}

fn _json_test_object() {
    let r = json_parse("{\"name\": \"Alice\", \"age\": 30}");
    print("name = " + r["name"]);
    print("age = " + str(r["age"]));
}

fn _json_test_nested() {
    let r = json_parse("{\"items\": [1, 2, 3], \"ok\": true}");
    let items = r["items"];
    print("items[0] = " + str(items[0]));
    print("items len = " + str(len(items)));
    print("ok = " + str(r["ok"]));
}

fn _json_test_roundtrip() {
    let src = "{\"a\": 1, \"b\": [true, false], \"c\": \"hi\\nthere\"}";
    let parsed = json_parse(src);
    let out = json_stringify(parsed);
    print("roundtrip: " + out);
}

// Uncomment to run tests when executing json.donk directly:
// _json_test_simple();
// _json_test_object(); 
// _json_test_nested();
// _json_test_roundtrip();