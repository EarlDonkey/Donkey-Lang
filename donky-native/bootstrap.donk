// bootstrap.donk — The Final Boss
import "compiler.donk";
import "vm.donk";

fn main() {
    print("=== BOOTSTRAP START ===");
    
    // 1. Compile the compiler
    let source = read_file("compiler.donk");
    let tokens = tokenize(source);
    let ast = parse(tokens);
    let bytecode = compile(ast);
    write_file("compiler.bytecode", join(bytecode, "\n"));
    print("Successfully compiled compiler.donk (" + str(len(bytecode)) + " ops)");
    
    // 2. Run the COMPILED compiler on test_math.donk
    print("Running compiled compiler...");
    let bc_lines = split(read_file("compiler.bytecode"), "\n");
    run_bytecode(bc_lines, ["test_math.donk"]);
    
    // 3. Execute the generated bytecode
    print("=== RUNNING GENERATED BYTECODE ===");
    let final_bc = split(read_file("test_math.donk.bytecode"), "\n");
    run_bytecode(final_bc, []);
    
    print("=== BOOTSTRAP SUCCESS ===");
}

main();