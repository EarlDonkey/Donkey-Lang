if len(args) < 1 {
    print("Usage: donky-native native_wc.donk <file>");
} else {
    let file = args[0];
    if !file_exists(file) {
        print("File not found: " + file);
    } else {
        let text = read_file(file);
        let lines = split(text, "\n");
        print("File: " + file);
        print("Lines: " + str(len(lines)));
        print("Chars: " + str(len(text)));
    }
}