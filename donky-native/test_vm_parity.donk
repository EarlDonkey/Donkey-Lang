print("=== VM Parity Test ===");

// For loops + break/continue
let sum = 0;
for n in [1, 2, 3, 4, 5, 6, 7] {
    if n == 6 { break; }
    if n == 3 { continue; }
    sum += n;
}
print("For+break+continue: sum=" + str(sum));  // 1+2+4+5 = 12

// Anonymous function
let doubler = fn(x) -> num { return x * 2; };
print("Anonymous fn: " + str(doubler(21)));  // 42

// String interpolation
let who = "World";
print("Interpolation: Hello ${who}!");

// Try/catch
try {
    throw "boom!";
} catch e {
    print("Caught: " + e);
}

// Unicode-ish interpolation
let a = 10;
let b = 20;
print("Math in string: ${a} + ${b} = ${a + b}");

// Struct methods still work
struct Point { x: num, y: num }
fn Point.move(self, dx, dy) {
    self.x += dx;
    self.y += dy;
}
let p = Point { x: 10, y: 20 };
p.move(5, -5);
print("Point: x=" + str(p.x) + ", y=" + str(p.y));