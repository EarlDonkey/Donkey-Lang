// donky-playground.donk — Donky language playground & web server
// Run from DonkyPlay/ directory:
//   .\donky-native.exe vm donky-playground.donk
// Then open http://localhost:8080 in a browser.

import "json.donk";

// ============================================================
// HTTP parsing & helpers
// ============================================================

fn http_split_headers(raw) -> array {
    let sep = "\r\n\r\n";
    if !contains(raw, sep) {
        sep = "\n\n";
    }
    let parts = split(raw, sep);
    if len(parts) < 2 {
        return [parts[0], ""];
    }
    let body = "";
    let i = 1;
    while i < len(parts) {
        if i > 1 { body = body + sep; }
        body = body + parts[i];
        i = i + 1;
    }
    return [parts[0], body];
}

fn http_first_line(headers) -> array {
    let lines = split(headers, "\r\n");
    if len(lines) == 1 {
        lines = split(headers, "\n");
    }
    let parts = split(lines[0], " ");
    if len(parts) < 3 {
        return ["GET", "/"];
    }
    return [parts[0], parts[1]];
}

fn http_content_length(headers) -> num {
    let lines = split(headers, "\r\n");
    if len(lines) == 1 {
        lines = split(headers, "\n");
    }
    for line in lines {
        let kv = split(line, ":");
        if len(kv) >= 2 {
            if lower(trim(kv[0])) == "content-length" {
                return num(trim(kv[1]));
            }
        }
    }
    return 0;
}

fn http_response(status, content_type, body) -> string {
    let head = "HTTP/1.1 " + status + "\r\n"
        + "Content-Type: " + content_type + "\r\n"
        + "Content-Length: " + str(len(body)) + "\r\n"
        + "Connection: close\r\n"
        + "\r\n";
    return head + body;
}

// ============================================================
// Routes
// ============================================================

fn route_index() -> string {
    if !file_exists("index.html") {
        return http_response("404 Not Found", "text/plain", "index.html missing");
    }
    let html = read_file("index.html");
    return http_response("200 OK", "text/html; charset=utf-8", html);
}

fn route_run(body) -> string {
    let result = {};
    try {
        let req = json_parse(body);
        let code = json_get(req, "code", "");
        if code == "" {
            result["ok"] = false;
            result["output"] = "empty code";
            return http_response("200 OK", "application/json", json_stringify(result));
        }

        // Generate unique temporary file to prevent race conditions across concurrent requests
        let rand_id = str(random(999999));
        let tmp_file = "temp_snippet_" + rand_id + ".donk";
        write_file(tmp_file, code);

        // Execute VM directly via system() which captures stdout and stderr
        let output = system(".\\donky-native.exe vm " + tmp_file);

        // Clean up temporary snippet file
        system("cmd /C del /f /q " + tmp_file + " >nul 2>&1");

        result["ok"] = true;
        result["output"] = output;
        return http_response("200 OK", "application/json", json_stringify(result));
    } catch e {
        result["ok"] = false;
        result["output"] = "server error: " + e;
        return http_response("500 Internal Server Error", "application/json", json_stringify(result));
    }
}

// ============================================================
// Main Server Loop
// ============================================================

fn main() {
    print("Donky Playground starting on http://localhost:8080");
    print("Press Ctrl+C to stop.");
    let server_id = tcp_listen(8080);
    while true {
        let client_id = tcp_accept(server_id);
        if client_id > 0 {
            let raw = tcp_read(client_id, 65536);
            if len(raw) > 0 {
                let split_result = http_split_headers(raw);
                let headers = split_result[0];
                let body = split_result[1];

                // Ensure full body payload is received if fragmented over TCP
                let expected_len = http_content_length(headers);
                while expected_len > 0 && len(body) < expected_len {
                    let chunk = tcp_read(client_id, 65536);
                    if len(chunk) == 0 { break; }
                    body = body + chunk;
                }

                let req_line = http_first_line(headers);
                let method = req_line[0];
                let path = req_line[1];

                let response = "";
                if method == "POST" && path == "/run" {
                    response = route_run(body);
                } else if method == "GET" && path == "/favicon.ico" {
                    response = http_response("404 Not Found", "text/plain", "");
                } else {
                    // Single Page Application (SPA) routing: serve index.html for all UI paths
                    response = route_index();
                }

                tcp_write(client_id, response);
            }
            tcp_close(client_id);
        }
    }
}

main();