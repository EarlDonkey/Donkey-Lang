let counts = {"a": 1, "b": 2};
print(counts);
print(counts["a"]);
print(len(counts));

counts["c"] = 3;
counts["a"] = 10;
print(counts);

let ks = keys(counts);
print(ks);
print(len(ks));

print(contains(counts, "a"));
print(contains(counts, "z"));

let word_count = {};
let words = ["apple", "banana", "apple", "cherry", "banana", "apple"];
for w in words {
    if contains(word_count, w) {
        word_count[w] = word_count[w] + 1;
    } else {
        word_count[w] = 1;
    }
}
print(word_count);