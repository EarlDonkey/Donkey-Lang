fn collatz_len(n) -> num {
    let steps = 0;
    let cur = n;
    while cur != 1 {
        if cur % 2 == 0 {
            cur = cur / 2;
        } else {
            cur = cur * 3 + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

let best_n = 1;
let best_len = 0;
let i = 1;
while i < 1000 {
    let l = collatz_len(i);
    if l > best_len {
        best_len = l;
        best_n = i;
    }
    i = i + 1;
}
print(best_n);
print(best_len);