let s = "hello world";

print(len(s));
print(s[0]);
print(s[4]);
print(s[10]);

let i = 0;
while i < len(s) {
    if s[i] == " " {
        print("_");
    } else {
        print(s[i]);
    }
    i = i + 1;
}

let parts = split("a,b,c,d", ",");
print(parts);
print(len(parts));

let rejoined = join(parts, "|");
print(rejoined);

print(contains(s, "world"));
print(contains(s, "xyz"));

print(upper("hello"));
print(lower("HELLO"));
print(trim("  padded  "));
print(replace("a-b-c", "-", "+"));