fn to_roman(n) -> str {
    let r = "";
    while n >= 1000 { r = r + "M";  n = n - 1000; }
    while n >= 900  { r = r + "CM"; n = n - 900; }
    while n >= 500  { r = r + "D";  n = n - 500; }
    while n >= 400  { r = r + "CD"; n = n - 400; }
    while n >= 100  { r = r + "C";  n = n - 100; }
    while n >= 90   { r = r + "XC"; n = n - 90; }
    while n >= 50   { r = r + "L";  n = n - 50; }
    while n >= 40   { r = r + "XL"; n = n - 40; }
    while n >= 10   { r = r + "X";  n = n - 10; }
    while n >= 9    { r = r + "IX"; n = n - 9; }
    while n >= 5    { r = r + "V";  n = n - 5; }
    while n >= 4    { r = r + "IV"; n = n - 4; }
    while n >= 1    { r = r + "I";  n = n - 1; }
    return r;
}

print(to_roman(1994));
print(to_roman(2024));
print(to_roman(4));