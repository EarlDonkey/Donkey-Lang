let port = 8080;
let db_path = "examples/public/guestbook.txt";

print("Starting Donky Guestbook Server...");
let server = tcp_listen(port);
print("Listening on http://localhost:${port}");

fn get_entries_html() -> str {
    if !file_exists(db_path) {
        return "<p>No entries yet. Be the first!</p>";
    }
    let lines = split(read_file(db_path), "\n");
    let html = "";
    for line in lines {
        if len(trim(line)) > 0 {
            let parts = split(line, "|");
            if len(parts) == 2 {
                html = html + "<div class='entry'><div class='author'>" + parts[0] + "</div><p>" + parts[1] + "</p></div>";
            }
        }
    }
    if len(html) == 0 {
        return "<p>No entries yet. Be the first!</p>";
    }
    return html;
}

fn handle_client(client) -> void {
    let request = tcp_read(client, 8192);
    if len(request) == 0 {
        tcp_close(client);
        return;
    }

    let parts = split(request, "\r\n\r\n");
    let headers = split(parts[0], "\r\n");
    let req_line = split(headers[0], " ");
    let method = req_line[0];
    let path = req_line[1];

    if method == "GET" {
        let filepath = "examples/public" + path;
        if path == "/" { filepath = "examples/public/index.html"; }
        
        if file_exists(filepath) {
            let body = read_file(filepath);
            let mime = mime_type(filepath);
            
            if mime == "text/html" {
                body = replace(body, "{{ENTRIES}}", get_entries_html());
            }
            
            let resp = "HTTP/1.1 200 OK\r\nContent-Type: " + mime + "\r\nConnection: close\r\n\r\n" + body;
            tcp_write(client, resp);
        } else {
            let msg = "<h1>404 Not Found</h1><p>The page you requested doesn't exist.</p>";
            let resp = "HTTP/1.1 404 Not Found\r\nContent-Type: text/html\r\nConnection: close\r\n\r\n" + msg;
            tcp_write(client, resp);
        }
    } else if method == "POST" {
        if path == "/sign" {
            let body = "";
            if len(parts) > 1 {
                body = parts[1];
            }
            
            // Parse the form data (name=Alice&message=Hello)
            let fields = split(body, "&");
            let name = "Anonymous";
            let msg = "";
            
            for f in fields {
                let kv = split(f, "=");
                if len(kv) == 2 {
                    if kv[0] == "name" {
                        name = url_decode(replace(kv[1], "+", " "));
                    } else if kv[0] == "message" {
                        msg = url_decode(replace(kv[1], "+", " "));
                    }
                }
            }
            
            // Save to file
            let entry = name + "|" + msg + "\n";
            let existing = "";
            if file_exists(db_path) {
                existing = read_file(db_path);
            }
            write_file(db_path, existing + entry);
            
            // Redirect back to home
            let resp = "HTTP/1.1 302 Found\r\nLocation: /\r\nConnection: close\r\n\r\n";
            tcp_write(client, resp);
        }
    }
    
    tcp_close(client);
}

while true {
    let client = tcp_accept(server);
    // Spawn a thread to handle this client so the server doesn't block!
    spawn(fn() -> void { handle_client(client); });
}