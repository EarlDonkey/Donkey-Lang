// logtop.donk — count log entries by a field, print top N.
//
// Usage: donky examples/logtop.donk FILE [field] [n]
//   field: ip | status | path | method   (default: ip)
//   n:     number of top results         (default: 10)
//
// Expects Apache/Nginx "common log format":
//   IP - - [timestamp] "METHOD /path HTTP/x.x" STATUS SIZE

import "../lib/list.donk";
import "../lib/format.donk";

fn analyze(path, field, limit) -> void {
    if !file_exists(path) {
        throw "file not found: " + path;
    }

    let text = read_file(path);
    let lines = split(text, "\n");
    let counts = {};
    let total = 0;
    let skipped = 0;

    for line in lines {
        let t = trim(line);
        if len(t) == 0 { continue; }

        let parts = split(t, " ");
        if len(parts) < 9 {
            skipped = skipped + 1;
            continue;
        }

        let value = "";
        if field == "ip" {
            value = parts[0];
        } else if field == "method" {
            value = replace(parts[5], "\"", "");
        } else if field == "path" {
            value = parts[6];
        } else if field == "status" {
            value = parts[8];
        } else {
            throw "unknown field: " + field;
        }

        if len(value) == 0 { continue; }

        if contains(counts, value) {
            counts[value] = counts[value] + 1;
        } else {
            counts[value] = 1;
        }
        total = total + 1;
    }

    // Build [key, count] pairs, sort ascending by count, reverse for desc.
    let entries = [];
    for k in counts {
        push(entries, [k, counts[k]]);
    }
    let ranked = reverse(sort_by(entries, fn(pair) -> num { return pair[1]; }));

    print("=== " + field + " — total " + str(total)
          + " entries, " + str(len(counts)) + " unique"
          + " — top " + str(limit) + " ===");
    let shown = 0;
    for pair in ranked {
        if shown >= limit { break; }
        print(pad_left(str(pair[1]), 6, " ") + "  " + pair[0]);
        shown = shown + 1;
    }
    if skipped > 0 {
        print("(" + str(skipped) + " malformed line(s) skipped)");
    }
}

if len(args) < 1 {
    print("usage: logtop.donk FILE [field] [n]");
    print("  field: ip | status | path | method   (default: ip)");
    print("  n:     number of top results         (default: 10)");
} else {
    let path = args[0];
    let field = "ip";
    let limit = 10;
    if len(args) >= 2 { field = args[1]; }
    if len(args) >= 3 { limit = num(args[2]); }
    analyze(path, field, limit);
}