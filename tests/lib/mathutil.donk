fn gcd(a, b) -> num {
    while b != 0 {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}

fn lcm(a, b) -> num {
    return (a * b) div gcd(a, b);
}

fn is_prime(n) -> bool {
    if n < 2 { return false; }
    if n == 2 { return true; }
    if n % 2 == 0 { return false; }
    let d = 3;
    while d * d <= n {
        if n % d == 0 { return false; }
        d = d + 2;
    }
    return true;
}