import "lib/datetime.donk";

// Known timestamps
// 1970-01-01T00:00:00Z = 0
assert_eq(to_iso(0), "1970-01-01T00:00:00Z");
// 2000-01-01T00:00:00Z = 946684800
assert_eq(to_iso(946684800), "2000-01-01T00:00:00Z");
// 2024-02-29T12:34:56Z = 1709210096
assert_eq(to_iso(1709210096), "2024-02-29T12:34:56Z");

// Component accessors
assert_eq(year_of(0), 1970);
assert_eq(month_of(0), 1);
assert_eq(day_of(0), 1);

// Arithmetic
assert_eq(to_iso(add_days(0, 1)), "1970-01-02T00:00:00Z");
assert_eq(to_iso(add_hours(0, 25)), "1970-01-02T01:00:00Z");

// Elapsed formatting
assert_eq(elapsed_str(0), "0s");
assert_eq(elapsed_str(45), "45s");
assert_eq(elapsed_str(3725), "1h 2m 5s");
assert_eq(elapsed_str(90061), "1d 1h 1m 1s");

// now() returns a plausible number
let t = now();
assert_true(t > 1700000000);
assert_true(t < 2000000000);