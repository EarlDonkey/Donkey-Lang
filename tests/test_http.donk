fn read_until(client, delim, max_bytes) {
    let buf = "";
    while len(buf) < max_bytes {
        let chunk = tcp_read(client, 4096);
        if len(chunk) == 0 { break; }
        buf = buf + chunk;
        if contains(buf, delim) { break; }
    }
    return buf;
}

fn get_path(raw_req) {
    let lines = split(raw_req, "\r\n");
    if len(lines) == 0 { return "/index.html"; }
    
    let parts = split(lines[0], " ");
    if len(parts) < 2 { return "/index.html"; }
    
    let path = parts[1];
    if path == "/" { return "/index.html"; }
    if contains(path, "..") { return "/404.html"; }
    return path;
}

fn mime_for(path) {
    if contains(path, ".css") { return "text/css"; }
    if contains(path, ".js")  { return "text/javascript"; }
    if contains(path, ".png") { return "image/png"; }
    if contains(path, ".jpg") { return "image/jpeg"; }
    if contains(path, ".svg") { return "image/svg+xml"; }
    if contains(path, ".ico") { return "image/x-icon"; }
    return "text/html";
}

fn test_get_path() {
    let raw1 = "GET /about.html HTTP/1.1\r\nHost: localhost\r\n\r\n";
    let raw2 = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n";
    
    if get_path(raw1) == "/about.html" { print("PASS: get_path file"); } else { print("FAIL: get_path file"); }
    if get_path(raw2) == "/index.html" { print("PASS: get_path root"); } else { print("FAIL: get_path root"); }
}

fn test_mime() {
    if mime_for("/style.css") == "text/css" { print("PASS: mime css"); } else { print("FAIL: mime css"); }
    if mime_for("/image.png") == "image/png" { print("PASS: mime png"); } else { print("FAIL: mime png"); }
    if mime_for("/index.html") == "text/html" { print("PASS: mime html"); } else { print("FAIL: mime html"); }
}

test_get_path();
test_mime();