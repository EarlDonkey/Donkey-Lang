import "lib/http.donk";

fn handle_client(client) {
    let raw_req = read_until(client, "\r\n\r\n", 8192);
    let path = get_path(raw_req);
    let full_path = "examples/public" + path; // Note: fix this path to your actual folder!
    
    let body = "";
    let status = "200 OK";
    let mime = mime_for(path);
    
    try {
        body = read_file(full_path);
    } catch e {
        status = "404 Not Found";
        mime = "text/plain";
        body = "Donky says: " + str(e);
    }
    
    let response = "HTTP/1.1 ${status}\r\n" +
                   "Content-Type: ${mime}\r\n" +
                   "Content-Length: ${len(body)}\r\n" +
                   "Connection: close\r\n\r\n" + 
                   body;

    tcp_write(client, response);
    tcp_close(client);
}

let port = 8080;
let server = tcp_listen(port);
print("Concurrent server running on http://localhost:${port} ...");

while true {
    gc(); // Safe point: collect garbage before accepting a new connection
    let client = tcp_accept(server);
    spawn(handle_client, client);
}