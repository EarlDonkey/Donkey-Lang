// lib/list.donk — higher-order helpers for arrays.
// Import with: import "lib/list.donk";
//
// Parameters that receive a function are named `f` because `fn` is a
// reserved keyword in Donky.

fn map(arr, f) -> array {
    let out = [];
    for x in arr {
        push(out, f(x));
    }
    return out;
}

fn filter(arr, f) -> array {
    let out = [];
    for x in arr {
        if f(x) {
            push(out, x);
        }
    }
    return out;
}

fn reduce(arr, f, init) -> any {
    let acc = init;
    for x in arr {
        acc = f(acc, x);
    }
    return acc;
}

fn reverse(arr) -> array {
    let out = [];
    let i = len(arr) - 1;
    while i >= 0 {
        push(out, arr[i]);
        i = i - 1;
    }
    return out;
}

fn unique(arr) -> array {
    let out = [];
    for x in arr {
        if !contains(out, x) {
            push(out, x);
        }
    }
    return out;
}

fn any(arr, f) -> bool {
    for x in arr {
        if f(x) {
            return true;
        }
    }
    return false;
}

fn all(arr, f) -> bool {
    for x in arr {
        if !f(x) {
            return false;
        }
    }
    return true;
}

fn count(arr, f) -> num {
    let n = 0;
    for x in arr {
        if f(x) {
            n = n + 1;
        }
    }
    return n;
}

// Return a new array, sorted ascending by the result of f.
// f must return a number or a string (both are comparable).
// Stable: equal keys preserve their original relative order.
// Non-mutating: arr is unchanged.
// Call reverse(sort_by(...)) for descending order.
//
// Implementation is bubble sort — O(n^2). Fine for hundreds of items.
// Promotion to a builtin (with faster sorting) is a future compiler
// change; see ROADMAP.
fn sort_by(arr, f) -> array {
    let keyed = [];
    for x in arr {
        push(keyed, [f(x), x]);
    }
    let n = len(keyed);
    let i = 0;
    while i < n {
        let j = 0;
        while j < n - 1 - i {
            if keyed[j][0] > keyed[j + 1][0] {
                let t = keyed[j];
                keyed[j] = keyed[j + 1];
                keyed[j + 1] = t;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let out = [];
    for pair in keyed {
        push(out, pair[1]);
    }
    return out;
}