// lib/format.donk — number and string formatting helpers.
// Import with: import "lib/format.donk";

// Repeat a string n times. repeat("ab", 3) -> "ababab"
fn repeat(s, n) -> str {
    let out = "";
    let i = 0;
    while i < n {
        out = out + s;
        i = i + 1;
    }
    return out;
}

// Pad s on the left with character c until it's w characters wide.
// pad_left("42", 5, " ") -> "   42"
fn pad_left(s, w, c) -> str {
    let out = s;
    while len(out) < w {
        out = c + out;
    }
    return out;
}

// Pad s on the right with character c until it's w characters wide.
// pad_right("hi", 5, ".") -> "hi..."
fn pad_right(s, w, c) -> str {
    let out = s;
    while len(out) < w {
        out = out + c;
    }
    return out;
}

// Format a number with exactly `places` decimal places.
// Truncates rather than rounds — format_num(3.999, 2) -> "3.99".
// format_num(3.14159, 2) -> "3.14", format_num(5, 2) -> "5.00"
fn format_num(x, places) -> str {
    let neg = false;
    if x < 0 {
        neg = true;
        x = -x;
    }

    // Compute 10^places
    let mult = 1;
    let i = 0;
    while i < places {
        mult = mult * 10;
        i = i + 1;
    }

    // Scale by mult, then take the integer part of that.
    // There's no floor/round builtin, so we string-parse the integer part.
    let scaled = x * mult;
    let s = str(scaled);
    let int_part_str = "";
    for ch in s {
        if ch == "." {
            break;
        }
        int_part_str = int_part_str + ch;
    }
    let int_val = num(int_part_str);

    // Split int_val into whole and fractional parts
    let whole = int_val div mult;
    let frac_int = int_val % mult;
    let frac_str = str(frac_int);
    while len(frac_str) < places {
        frac_str = "0" + frac_str;
    }

    let result = str(whole);
    if places > 0 {
        result = result + "." + frac_str;
    }
    if neg && int_val != 0 {
        result = "-" + result;
    }
    return result;
}