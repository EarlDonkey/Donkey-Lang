// lib/math.donk — small numeric helpers.
// Import with: import "lib/math.donk";

fn min(a, b) -> num {
    if a < b { return a; }
    return b;
}

fn max(a, b) -> num {
    if a > b { return a; }
    return b;
}

fn abs(n) -> num {
    if n < 0 { return -n; }
    return n;
}

// Integer exponent: pow(2, 10) -> 1024
fn pow(base, exp) -> num {
    let result = 1;
    let i = 0;
    while i < exp {
        result = result * base;
        i = i + 1;
    }
    return result;
}

// Square root via Newton's method. Converges to ~6 digits in 20 iterations.
// sqrt(16) -> 4.0, sqrt(2) -> ~1.414
fn sqrt(n) -> num {
    if n < 0 {
        throw "sqrt of negative number";
    }
    if n == 0 {
        return 0;
    }
    let guess = n / 2;
    let i = 0;
    while i < 20 {
        guess = (guess + n / guess) / 2;
        i = i + 1;
    }
    return guess;
}