// lib/csv.donk — simple CSV parsing and formatting.
// Import with: import "lib/csv.donk";
//
// Limitation: no quoted fields in v1. Commas inside values will be split.
// If you need quoted fields, that's a feature to add later.

// Parse a CSV line into an array of strings.
// parse_line("a,b,c") -> ["a", "b", "c"]
fn parse_line(line) -> array {
    return split(line, ",");
}

// Join an array of strings into a CSV line.
// format_line(["a", "b", "c"]) -> "a,b,c"
fn format_line(fields) -> str {
    return join(fields, ",");
}

// Parse a whole CSV file body (with newlines) into an array of rows.
// Each row is an array of strings. Blank lines are skipped.
fn parse_table(text) -> array {
    let rows = [];
    for line in split(text, "\n") {
        if len(trim(line)) > 0 {
            push(rows, parse_line(line));
        }
    }
    return rows;
}

// Format an array of rows into a CSV body (with newlines).
fn format_table(rows) -> str {
    let lines = [];
    for row in rows {
        push(lines, format_line(row));
    }
    return join(lines, "\n");
}