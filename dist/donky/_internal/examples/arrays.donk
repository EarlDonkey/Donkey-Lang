print(a);

let nums = [];
let i = 0;
while i < 5 {
    push(nums, i * i);
    i = i + 1;
}
print(nums);

let sum = 0;
let j = 0;
while j < len(nums) {
    sum = sum + nums[j];
    j = j + 1;
}
print(sum);