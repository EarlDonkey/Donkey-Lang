for c in "abc" {
    print(c);
}

let arr = [10, 20, 30];
for x in arr {
    print(x);
}

let m = {"x": 1, "y": 2, "z": 3};
for k in m {
    print(k + "=" + str(m[k]));
}

// break
for x in [1, 2, 3, 4, 5] {
    if x > 3 {
        break;
    }
    print(x);
}

// continue
for x in [1, 2, 3, 4, 5] {
    if x % 2 == 0 {
        continue;
    }
    print(x);
}

// nested
for i in [1, 2] {
    for j in [10, 20] {
        print(str(i) + "-" + str(j));
    }
}